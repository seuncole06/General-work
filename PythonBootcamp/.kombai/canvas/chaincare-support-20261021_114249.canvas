      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\n  .font-ui { font-family: 'Barlow', ui-sans-serif, system-ui, sans-serif; }\n  .font-code { font-family: 'Space Mono', ui-monospace, SFMono-Regular, monospace; }\n  .bg-page { background-color: #1C2A39; }\n  .well {\n    background-color: #16222F;\n    box-shadow: inset 0 2px 7px rgba(0,0,0,0.45), inset 0 0 0 1px rgba(90,200,244,0.13);\n  }\n  .well:focus {\n    box-shadow: inset 0 2px 7px rgba(0,0,0,0.45), inset 0 0 0 1px rgba(90,200,244,0.6);\n    outline: none;\n  }\n  .well::placeholder { color: #9DB0C4; }\n  select.well option { background-color: #16222F; color: #E8F0F6; }\n  .rule-wash {\n    background-image: linear-gradient(90deg, rgba(90,200,244,0.75), rgba(38,55,72,0.15));\n  }\n  .cat-card { background-color: #22323F; border: 1px solid rgba(90,200,244,0.13); }\n  .cat-card:hover { background-color: #263A4A; }\n  .cat-card.is-active { background-color: #263A4A; }\n  .cat-grid {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    border: 1px solid rgba(90,200,244,0.14);\n    border-radius: 6px;\n    overflow: hidden;\n  }\n  .cat-grid .cat-card {\n    margin-bottom: 0;\n    border-radius: 0;\n    border: 0;\n    border-right: 1px solid rgba(90,200,244,0.10);\n    border-bottom: 1px solid rgba(90,200,244,0.10);\n  }\n  .cat-grid .cat-card:hover { background-color: #263A4A; box-shadow: inset 0 0 0 1px rgba(90,200,244,0.45); }\n  .cat-grid .cat-card.is-active { background-color: #263A4A; box-shadow: inset 0 0 0 1px rgba(90,200,244,0.7); }\n  @media (max-width: 1023px) { .cat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }\n  @media (max-width: 639px) { .cat-grid { grid-template-columns: minmax(0, 1fr); } }\n</style>\n<div class=\"min-h-screen bg-page font-ui text-[#E8F0F6] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- ================= HEADER ================= -->\n    <header class=\"border-b border-[#5AC8F4]/12\" data-kid=\"1-1\" data-name=\"site header with branding and nav\">\n        <div class=\"mx-auto flex max-w-[1180px] items-center justify-between gap-6 px-8 py-4\" data-kid=\"1-1-1\" data-name=\"header top bar container\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand logo and identity block\">\n                <span class=\"flex h-9 w-9 items-center justify-center rounded-sm border border-[#5AC8F4]/25 bg-[#16222F] text-[18px] text-[#5AC8F4]\" data-kid=\"1-1-1-1-1\" data-name=\"logo icon badge (shield-check)\">\n                    <i class=\"icon-shield-check\" data-kid=\"1-1-1-1-1-1\" data-name=\"shield-check icon\">\n                    </i>\n                </span>\n                <span class=\"flex flex-col leading-none\" data-kid=\"1-1-1-1-2\" data-name=\"brand name and tagline container\">\n                    <span class=\"text-[19px] font-semibold tracking-tight\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand name text\">\n                        Asset RPC\n                    </span>\n                    <span class=\"font-code text-[11.5px] tracking-wider text-[#9DB0C4]\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand tagline URL text\">\n                        https://asset-rpc.netlify\n                    </span>\n                </span>\n            </div>\n            <nav class=\"hidden items-center gap-8 text-[14px] text-[#AFC0D2] lg:flex\" data-kid=\"1-1-1-2\" data-name=\"main navigation links\">\n                <a class=\"hover:text-[#E8F0F6]\" data-kid=\"1-1-1-2-1\" data-name=\"navigation link — start a request\" href=\"#request\">\n                    Start a request\n                </a>\n                <a class=\"hover:text-[#E8F0F6]\" data-kid=\"1-1-1-2-2\" data-name=\"navigation link — common issues\" href=\"#issues\">\n                    Common issues\n                </a>\n                <a class=\"hover:text-[#E8F0F6]\" data-kid=\"1-1-1-2-3\" data-name=\"navigation link — contact\" href=\"#contact\">\n                    Contact\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-3\" data-name=\"header right actions group\">\n                <span class=\"hidden items-center gap-2 rounded-sm border border-[#5AC8F4]/18 bg-[#22323F] px-3 py-1.5 text-[12px] text-[#AFC0D2] md:flex\" data-kid=\"1-1-1-3-1\" data-name=\"no-wallet-needed badge\">\n                    <i class=\"icon-shield text-[13px] text-[#5AC8F4]\" data-kid=\"1-1-1-3-1-1\" data-name=\"shield icon (no wallet badge)\">\n                    </i>\n                    No wallet connection required\n                </span>\n                <a class=\"flex items-center gap-2 rounded-sm bg-[#5AC8F4] px-4 py-2 text-[13px] font-semibold text-[#0F1C28] hover:bg-[#7AD6F8]\" data-kid=\"1-1-1-3-2\" data-name=\"header email support CTA button\" href=\"mailto:Willsmith199425@gmail.com\">\n                    <i class=\"icon-mail text-[14px]\" data-kid=\"1-1-1-3-2-1\" data-name=\"mail icon (email CTA)\">\n                    </i>\n                    Email support\n                </a>\n            </div>\n        </div>\n        <div class=\"border-t border-[#5AC8F4]/10 bg-[#192734]\" data-kid=\"1-1-2\" data-name=\"header security notice bar\">\n            <div class=\"mx-auto flex max-w-[1180px] items-center gap-2.5 px-8 py-2.5 text-[12.5px] text-[#9DB0C4]\" data-kid=\"1-1-2-1\" data-name=\"security notice content row\">\n                <i class=\"icon-shield-lock text-[13px] text-[#5AC8F4]\" data-kid=\"1-1-2-1-1\" data-name=\"shield-lock security icon\">\n                </i>\n                <span data-kid=\"1-1-2-1-2\" data-name=\"security notice text\">\n                    You are on the Asset RPC support portal. Asset RPC staff will\n                    <span class=\"font-semibold text-[#E8F0F6]\" data-kid=\"1-1-2-1-2-1\" data-name=\"emphasis on word 'never' in security notice\">\n                        never\n                    </span>\n                    ask for your seed phrase or private keys.\n                </span>\n            </div>\n        </div>\n    </header>\n    <!-- ================= HERO / INTAKE ================= -->\n    <section class=\"mx-auto max-w-[1180px] px-8 pt-14 pb-16\" data-kid=\"1-2\" data-name=\"hero/intake section\" id=\"request\">\n        <div class=\"grid grid-cols-12 gap-10\" data-kid=\"1-2-1\" data-name=\"hero content two-column grid\">\n            <!-- LEFT: form -->\n            <div class=\"col-span-12 lg:col-span-7\" data-kid=\"1-2-1-1\" data-name=\"hero left column (form area)\">\n                <h1 class=\"reveal text-[44px] leading-[1.08] font-semibold tracking-tight\" data-kid=\"1-2-1-1-1\" data-name=\"hero headline\">\n                    Tell us what went wrong.\n                    <br class=\"hidden sm:block\" data-kid=\"1-2-1-1-1-1\" data-name=\"line break\"/>\n                    We take it from there.\n                </h1>\n                <p class=\"mt-5 max-w-[560px] text-[16px] leading-relaxed text-[#AFC0D2]\" data-kid=\"1-2-1-1-2\" data-name=\"hero intro paragraph\">\n                    Fill in four details about your issue. When you press\n                    <span class=\"text-[#E8F0F6]\" data-kid=\"1-2-1-1-2-1\" data-name=\"highlighted 'Open email draft' phrase\">\n                        Open email draft\n                    </span>\n                    , your mail app opens with everything numbered and ready — you review it and send it yourself.\n                </p>\n                <div class=\"reveal mt-8 rounded-md border border-[#5AC8F4]/14 bg-[#22323F]/80 p-6 sm:p-7\" data-kid=\"1-2-1-1-3\" data-name=\"support request form card\">\n                    <div class=\"flex items-center justify-between gap-4 border-b border-[#5AC8F4]/12 pb-4\" data-kid=\"1-2-1-1-3-1\" data-name=\"form card header row\">\n                        <h2 class=\"text-[17px] font-semibold\" data-kid=\"1-2-1-1-3-1-1\" data-name=\"form card title\">\n                            Support request details\n                        </h2>\n                        <span class=\"font-code text-[11px] text-[#8DA1B7]\" data-kid=\"1-2-1-1-3-1-2\" data-name=\"field count badge (4 fields)\">\n                            4 fields\n                        </span>\n                    </div>\n                    <div class=\"mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2\" data-kid=\"1-2-1-1-3-2\" data-name=\"form fields grid\">\n                        <!-- 1 -->\n                        <div data-kid=\"1-2-1-1-3-2-1\" data-name=\"issue type field group\">\n                            <label class=\"flex items-center gap-2.5 text-[13.5px] font-medium text-[#CBD8E4]\" data-kid=\"1-2-1-1-3-2-1-1\" data-name=\"issue type field label\" for=\"fType\">\n                                <span class=\"font-code flex h-5 w-5 items-center justify-center rounded-xs bg-[#5AC8F4]/12 text-[11px] text-[#5AC8F4]\" data-kid=\"1-2-1-1-3-2-1-1-1\" data-name=\"step number badge 1\">\n                                    1\n                                </span>\n                                Issue type\n                            </label>\n                            <div class=\"relative mt-2.5\" data-kid=\"1-2-1-1-3-2-1-2\" data-name=\"issue type select wrapper\">\n                                <select class=\"well w-full appearance-none rounded-sm px-4 py-3 text-[14.5px] text-[#E8F0F6]\" data-kid=\"1-2-1-1-3-2-1-2-1\" data-name=\"issue type dropdown select\" id=\"fType\">\n                                    <option data-kid=\"1-2-1-1-3-2-1-2-1-1\" data-name=\"option — Transaction pending or delayed\">\n                                        Transaction pending or delayed\n                                    </option>\n                                    <option data-kid=\"1-2-1-1-3-2-1-2-1-2\" data-name=\"option — RPC or node connection error\">\n                                        RPC or node connection error\n                                    </option>\n                                    <option data-kid=\"1-2-1-1-3-2-1-2-1-3\" data-name=\"option — Swap slippage\">\n                                        Swap slippage\n                                    </option>\n                                    <option data-kid=\"1-2-1-1-3-2-1-2-1-4\" data-name=\"option — Bridge transfer not arrived\">\n                                        Bridge transfer not arrived\n                                    </option>\n                                    <option data-kid=\"1-2-1-1-3-2-1-2-1-5\" data-name=\"option — Missing or incorrect balance\">\n                                        Missing or incorrect balance\n                                    </option>\n                                    <option data-kid=\"1-2-1-1-3-2-1-2-1-6\" data-name=\"option — Token approval stuck\">\n                                        Token approval stuck\n                                    </option>\n                                    <option data-kid=\"1-2-1-1-3-2-1-2-1-7\" data-name=\"option — Failed contract interaction\">\n                                        Failed contract interaction\n                                    </option>\n                                    <option data-kid=\"1-2-1-1-3-2-1-2-1-8\" data-name=\"option — Wrong network selected\">\n                                        Wrong network selected\n                                    </option>\n                                    <option data-kid=\"1-2-1-1-3-2-1-2-1-9\" data-name=\"option — Staking or withdrawal issue\">\n                                        Staking or withdrawal issue\n                                    </option>\n                                    <option data-kid=\"1-2-1-1-3-2-1-2-1-10\" data-name=\"option — NFT transfer issue\">\n                                        NFT transfer issue\n                                    </option>\n                                    <option data-kid=\"1-2-1-1-3-2-1-2-1-11\" data-name=\"option — Exchange deposit missing\">\n                                        Exchange deposit missing\n                                    </option>\n                                    <option data-kid=\"1-2-1-1-3-2-1-2-1-12\" data-name=\"option — Something else\">\n                                        Something else\n                                    </option>\n                                </select>\n                                <i class=\"icon-chevron-down pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 text-[15px] text-[#8DA1B7]\" data-kid=\"1-2-1-1-3-2-1-2-2\" data-name=\"chevron-down icon (select arrow)\">\n                                </i>\n                            </div>\n                        </div>\n                        <!-- 2 -->\n                        <div data-kid=\"1-2-1-1-3-2-2\" data-name=\"network field group\">\n                            <label class=\"flex items-center gap-2.5 text-[13.5px] font-medium text-[#CBD8E4]\" data-kid=\"1-2-1-1-3-2-2-1\" data-name=\"network field label\" for=\"fNet\">\n                                <span class=\"font-code flex h-5 w-5 items-center justify-center rounded-xs bg-[#5AC8F4]/12 text-[11px] text-[#5AC8F4]\" data-kid=\"1-2-1-1-3-2-2-1-1\" data-name=\"step number badge 2\">\n                                    2\n                                </span>\n                                Network\n                            </label>\n                            <div class=\"relative mt-2.5\" data-kid=\"1-2-1-1-3-2-2-2\" data-name=\"network select wrapper\">\n                                <select class=\"well w-full appearance-none rounded-sm px-4 py-3 text-[14.5px] text-[#E8F0F6]\" data-kid=\"1-2-1-1-3-2-2-2-1\" data-name=\"network dropdown select\" id=\"fNet\">\n                                    <option data-kid=\"1-2-1-1-3-2-2-2-1-1\" data-name=\"option — Ethereum Mainnet\">\n                                        Ethereum Mainnet\n                                    </option>\n                                    <option data-kid=\"1-2-1-1-3-2-2-2-1-2\" data-name=\"option — Base\">\n                                        Base\n                                    </option>\n                                    <option data-kid=\"1-2-1-1-3-2-2-2-1-3\" data-name=\"option — Polygon\">\n                                        Polygon\n                                    </option>\n                                    <option data-kid=\"1-2-1-1-3-2-2-2-1-4\" data-name=\"option — Arbitrum One\">\n                                        Arbitrum One\n                                    </option>\n                                    <option data-kid=\"1-2-1-1-3-2-2-2-1-5\" data-name=\"option — Optimism\">\n                                        Optimism\n                                    </option>\n                                    <option data-kid=\"1-2-1-1-3-2-2-2-1-6\" data-name=\"option — Solana\">\n                                        Solana\n                                    </option>\n                                    <option data-kid=\"1-2-1-1-3-2-2-2-1-7\" data-name=\"option — BNB Chain\">\n                                        BNB Chain\n                                    </option>\n                                    <option data-kid=\"1-2-1-1-3-2-2-2-1-8\" data-name=\"option — Avalanche C-Chain\">\n                                        Avalanche C-Chain\n                                    </option>\n                                    <option data-kid=\"1-2-1-1-3-2-2-2-1-9\" data-name=\"option — Other network\">\n                                        Other network\n                                    </option>\n                                </select>\n                                <i class=\"icon-chevron-down pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 text-[15px] text-[#8DA1B7]\" data-kid=\"1-2-1-1-3-2-2-2-2\" data-name=\"chevron-down icon (select arrow)\">\n                                </i>\n                            </div>\n                        </div>\n                        <!-- 3 -->\n                        <div class=\"sm:col-span-2\" data-kid=\"1-2-1-1-3-2-3\" data-name=\"transaction hash field group\">\n                            <label class=\"flex items-center gap-2.5 text-[13.5px] font-medium text-[#CBD8E4]\" data-kid=\"1-2-1-1-3-2-3-1\" data-name=\"transaction hash field label\" for=\"fHash\">\n                                <span class=\"font-code flex h-5 w-5 items-center justify-center rounded-xs bg-[#5AC8F4]/12 text-[11px] text-[#5AC8F4]\" data-kid=\"1-2-1-1-3-2-3-1-1\" data-name=\"step number badge 3\">\n                                    3\n                                </span>\n                                Transaction hash\n                                <span class=\"font-code text-[11px] font-normal text-[#8DA1B7]\" data-kid=\"1-2-1-1-3-2-3-1-2\" data-name=\"optional tag next to hash label\">\n                                    optional\n                                </span>\n                            </label>\n                            <input class=\"well font-code mt-2.5 w-full rounded-sm px-4 py-3 text-[13.5px]\" data-kid=\"1-2-1-1-3-2-3-2\" data-name=\"transaction hash input field\" id=\"fHash\" placeholder=\"0x…  public hash only\" type=\"text\"/>\n                            <p class=\"mt-2 flex items-center gap-2 text-[12.5px] text-[#8DA1B7]\" data-kid=\"1-2-1-1-3-2-3-3\" data-name=\"hash safety tip row\">\n                                <i class=\"icon-eye text-[13px]\" data-kid=\"1-2-1-1-3-2-3-3-1\" data-name=\"eye icon (hash safety tip)\">\n                                </i>\n                                A transaction hash is public and safe to share. Never paste a private key or seed phrase here.\n                            </p>\n                        </div>\n                        <!-- 4 -->\n                        <div class=\"sm:col-span-2\" data-kid=\"1-2-1-1-3-2-4\" data-name=\"issue description field group\">\n                            <label class=\"flex items-center gap-2.5 text-[13.5px] font-medium text-[#CBD8E4]\" data-kid=\"1-2-1-1-3-2-4-1\" data-name=\"issue description field label\" for=\"fDesc\">\n                                <span class=\"font-code flex h-5 w-5 items-center justify-center rounded-xs bg-[#5AC8F4]/12 text-[11px] text-[#5AC8F4]\" data-kid=\"1-2-1-1-3-2-4-1-1\" data-name=\"step number badge 4\">\n                                    4\n                                </span>\n                                Issue description\n                            </label>\n                            <textarea class=\"well mt-2.5 w-full resize-none rounded-sm px-4 py-3 text-[14.5px] leading-relaxed\" data-kid=\"1-2-1-1-3-2-4-2\" data-name=\"issue description textarea\" id=\"fDesc\" placeholder=\"What were you doing, what did you expect, and what happened instead? Include any error message you saw.\" rows=\"4\"></textarea>\n                        </div>\n                    </div>\n                    <div class=\"mt-6 border-t border-[#5AC8F4]/12 pt-5\" data-kid=\"1-2-1-1-3-3\" data-name=\"form footer with action\">\n                        <button class=\"flex w-full items-center justify-center gap-2.5 rounded-sm bg-[#5AC8F4] px-6 py-3.5 text-[15px] font-semibold text-[#0F1C28] shadow-[0_6px_18px_rgba(0,0,0,0.45)] hover:bg-[#7AD6F8]\" data-kid=\"1-2-1-1-3-3-1\" data-name=\"open email draft primary button\" id=\"openDraft\" type=\"button\">\n                            <i class=\"icon-mail text-[16px]\" data-kid=\"1-2-1-1-3-3-1-1\" data-name=\"mail icon (primary button)\">\n                            </i>\n                            Open email draft\n                        </button>\n                        <p class=\"mt-3 text-center text-[12.5px] leading-relaxed text-[#9DB0C4]\" data-kid=\"1-2-1-1-3-3-2\" data-name=\"action helper text below button\">\n                            Opens your own email app with the preview shown here, addressed to\n                            <span class=\"font-code text-[#AFC0D2]\" data-kid=\"1-2-1-1-3-3-2-1\" data-name=\"email address highlighted in helper text\">\n                                Willsmith199425@gmail.com\n                            </span>\n                            . Nothing is sent automatically — you press send.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <!-- RIGHT: preview + security -->\n            <div class=\"col-span-12 flex flex-col gap-5 lg:col-span-5\" data-kid=\"1-2-1-2\" data-name=\"hero right column (preview + security)\">\n                <div class=\"reveal rounded-md border border-[#5AC8F4]/14 bg-[#233748] p-6\" data-kid=\"1-2-1-2-1\" data-name=\"email draft preview card\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-2-1-2-1-1\" data-name=\"email preview header row\">\n                        <h2 class=\"text-[15px] font-semibold\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"email preview title\">\n                            Email you will send\n                        </h2>\n                        <span class=\"font-code rounded-xs border border-[#5AC8F4]/20 px-2 py-0.5 text-[11.5px] tracking-wide text-[#5AC8F4]\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"DRAFT status badge\">\n                            DRAFT\n                        </span>\n                    </div>\n                    <dl class=\"mt-5 space-y-2 border-b border-[#5AC8F4]/12 pb-4 text-[13px]\" data-kid=\"1-2-1-2-1-2\" data-name=\"email recipient details list\">\n                        <div class=\"flex gap-3\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"recipient To row\">\n                            <dt class=\"w-14 shrink-0 text-[#8DA1B7]\" data-kid=\"1-2-1-2-1-2-1-1\" data-name=\"To label\">\n                                To\n                            </dt>\n                            <dd class=\"font-code text-[12.5px] break-all text-[#E8F0F6]\" data-kid=\"1-2-1-2-1-2-1-2\" data-name=\"To email address value\">\n                                Willsmith199425@gmail.com\n                            </dd>\n                        </div>\n                        <div class=\"flex gap-3\" data-kid=\"1-2-1-2-1-2-2\" data-name=\"subject row\">\n                            <dt class=\"w-14 shrink-0 text-[#8DA1B7]\" data-kid=\"1-2-1-2-1-2-2-1\" data-name=\"Subject label\">\n                                Subject\n                            </dt>\n                            <dd class=\"font-code text-[12.5px] text-[#CBD8E4]\" data-kid=\"1-2-1-2-1-2-2-2\" data-name=\"subject value container\">\n                                Asset RPC support —\n                                <span data-dynamic=\"true\" data-kid=\"1-2-1-2-1-2-2-2-1\" data-name=\"subject dynamic value (synced from form)\" data-reason=\"text replaced by sync() script based on issue type select\" id=\"pvSubj\">\n                                    Transaction pending or delayed\n                                </span>\n                            </dd>\n                        </div>\n                    </dl>\n                    <ol class=\"mt-4 space-y-3.5 text-[13.5px] leading-relaxed\" data-kid=\"1-2-1-2-1-3\" data-name=\"preview numbered list (issue summary)\">\n                        <li class=\"flex gap-3\" data-kid=\"1-2-1-2-1-3-1\" data-name=\"preview item 1 (issue type)\">\n                            <span class=\"font-code shrink-0 text-[#5AC8F4]\" data-kid=\"1-2-1-2-1-3-1-1\" data-name=\"preview item number 1\">\n                                1.\n                            </span>\n                            <span data-kid=\"1-2-1-2-1-3-1-2\" data-name=\"preview item 1 inner content\">\n                                <span class=\"text-[#8DA1B7]\" data-kid=\"1-2-1-2-1-3-1-2-1\" data-name=\"preview item 1 label\">\n                                    Issue type —\n                                </span>\n                                <span class=\"text-[#E8F0F6]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1-3-1-2-2\" data-name=\"preview issue type value (synced from form)\" data-reason=\"text replaced by sync() script based on issue type select\" id=\"pvType\">\n                                    Transaction pending or delayed\n                                </span>\n                            </span>\n                        </li>\n                        <li class=\"flex gap-3\" data-kid=\"1-2-1-2-1-3-2\" data-name=\"preview item 2 (network)\">\n                            <span class=\"font-code shrink-0 text-[#5AC8F4]\" data-kid=\"1-2-1-2-1-3-2-1\" data-name=\"preview item number 2\">\n                                2.\n                            </span>\n                            <span data-kid=\"1-2-1-2-1-3-2-2\" data-name=\"preview item 2 inner content\">\n                                <span class=\"text-[#8DA1B7]\" data-kid=\"1-2-1-2-1-3-2-2-1\" data-name=\"preview item 2 label\">\n                                    Network —\n                                </span>\n                                <span class=\"text-[#E8F0F6]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1-3-2-2-2\" data-name=\"preview network value (synced from form)\" data-reason=\"text replaced by sync() script based on network select\" id=\"pvNet\">\n                                    Ethereum Mainnet\n                                </span>\n                            </span>\n                        </li>\n                        <li class=\"flex gap-3\" data-kid=\"1-2-1-2-1-3-3\" data-name=\"preview item 3 (transaction hash)\">\n                            <span class=\"font-code shrink-0 text-[#5AC8F4]\" data-kid=\"1-2-1-2-1-3-3-1\" data-name=\"preview item number 3\">\n                                3.\n                            </span>\n                            <span class=\"min-w-0\" data-kid=\"1-2-1-2-1-3-3-2\" data-name=\"preview item 3 inner content\">\n                                <span class=\"text-[#8DA1B7]\" data-kid=\"1-2-1-2-1-3-3-2-1\" data-name=\"preview item 3 label\">\n                                    Transaction hash —\n                                </span>\n                                <span class=\"font-code text-[12px] break-all text-[#CBD8E4]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1-3-3-2-2\" data-name=\"preview hash value (synced from input)\" data-reason=\"text replaced by sync() script based on hash input\" id=\"pvHash\">\n                                    not provided\n                                </span>\n                            </span>\n                        </li>\n                        <li class=\"flex gap-3\" data-kid=\"1-2-1-2-1-3-4\" data-name=\"preview item 4 (description)\">\n                            <span class=\"font-code shrink-0 text-[#5AC8F4]\" data-kid=\"1-2-1-2-1-3-4-1\" data-name=\"preview item number 4\">\n                                4.\n                            </span>\n                            <span class=\"min-w-0\" data-kid=\"1-2-1-2-1-3-4-2\" data-name=\"preview item 4 inner content\">\n                                <span class=\"text-[#8DA1B7]\" data-kid=\"1-2-1-2-1-3-4-2-1\" data-name=\"preview item 4 label\">\n                                    Issue description —\n                                </span>\n                                <span class=\"text-[#CBD8E4] italic\" data-dynamic=\"true\" data-kid=\"1-2-1-2-1-3-4-2-2\" data-name=\"preview description value (synced from textarea)\" data-reason=\"text replaced by sync() script based on description textarea\" id=\"pvDesc\">\n                                    your description appears here as you type\n                                </span>\n                            </span>\n                        </li>\n                    </ol>\n                    <button class=\"mt-6 flex w-full items-center justify-center gap-2.5 rounded-sm border border-[#5AC8F4]/35 bg-[#1C2A39] px-5 py-3 text-[14px] font-semibold text-[#5AC8F4] hover:bg-[#1C2A39]/60 hover:border-[#5AC8F4]/60\" data-kid=\"1-2-1-2-1-4\" data-name=\"open in mail app secondary button\" id=\"openInMail\" type=\"button\">\n                        <i class=\"icon-send text-[15px]\" data-kid=\"1-2-1-2-1-4-1\" data-name=\"send icon (secondary button)\">\n                        </i>\n                        Open in my mail app\n                    </button>\n                </div>\n                <div class=\"reveal rounded-md border border-[#5AC8F4]/14 bg-[#22323F]/60 p-6\" data-kid=\"1-2-1-2-2\" data-name=\"what to expect info card\">\n                    <h2 class=\"text-[15px] font-semibold\" data-kid=\"1-2-1-2-2-1\" data-name=\"what to expect heading\">\n                        What to expect\n                    </h2>\n                    <ul class=\"mt-4 space-y-3.5 text-[13.5px] leading-relaxed text-[#AFC0D2]\" data-kid=\"1-2-1-2-2-2\" data-name=\"what to expect list\">\n                        <li class=\"flex gap-3\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"info list item 1 (no auto-send)\">\n                            <i class=\"icon-mail mt-0.5 shrink-0 text-[15px] text-[#5AC8F4]\" data-kid=\"1-2-1-2-2-2-1-1\" data-name=\"mail icon (info item 1)\">\n                            </i>\n                            <span data-kid=\"1-2-1-2-2-2-1-2\" data-name=\"info item 1 text\">\n                                This page only prepares the message. It sends nothing and submits nothing on your behalf.\n                            </span>\n                        </li>\n                        <li class=\"flex gap-3\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"info list item 2 (4 items needed)\">\n                            <i class=\"icon-file-text mt-0.5 shrink-0 text-[15px] text-[#5AC8F4]\" data-kid=\"1-2-1-2-2-2-2-1\" data-name=\"file-text icon (info item 2)\">\n                            </i>\n                            <span data-kid=\"1-2-1-2-2-2-2-2\" data-name=\"info item 2 text\">\n                                The four numbered items are all we need to start looking at the problem.\n                            </span>\n                        </li>\n                        <li class=\"flex gap-3\" data-kid=\"1-2-1-2-2-2-3\" data-name=\"info list item 3 (no wallet connect)\">\n                            <i class=\"icon-ban mt-0.5 shrink-0 text-[15px] text-[#5AC8F4]\" data-kid=\"1-2-1-2-2-2-3-1\" data-name=\"ban icon (info item 3)\">\n                            </i>\n                            <span data-kid=\"1-2-1-2-2-2-3-2\" data-name=\"info item 3 text\">\n                                We never ask you to connect a wallet, move funds, approve a contract or verify a wallet.\n                            </span>\n                        </li>\n                    </ul>\n                    <div class=\"well mt-5 flex items-start gap-3 rounded-sm px-4 py-4\" data-kid=\"1-2-1-2-2-3\" data-name=\"seed phrase warning callout\">\n                        <i class=\"icon-shield-lock mt-0.5 shrink-0 text-[17px] text-[#5AC8F4]\" data-kid=\"1-2-1-2-2-3-1\" data-name=\"shield-lock icon (warning callout)\">\n                        </i>\n                        <p class=\"text-[13.5px] leading-relaxed\" data-kid=\"1-2-1-2-2-3-2\" data-name=\"warning callout text\">\n                            <span class=\"font-semibold text-[#E8F0F6]\" data-kid=\"1-2-1-2-2-3-2-1\" data-name=\"warning headline text\">\n                                Never share your seed phrase or private keys.\n                            </span>\n                            <span class=\"text-[#9DB0C4]\" data-kid=\"1-2-1-2-2-3-2-2\" data-name=\"warning support text\">\n                                No legitimate support team needs them, and anyone who asks is trying to take your assets.\n                            </span>\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= ISSUE GRID ================= -->\n    <section class=\"border-t border-[#5AC8F4]/12 bg-[#1A2835]\" data-kid=\"1-3\" data-name=\"common issues section\" id=\"issues\">\n        <div class=\"mx-auto max-w-[1180px] px-8 py-16\" data-kid=\"1-3-1\" data-name=\"common issues inner container\">\n            <div class=\"reveal flex flex-wrap items-end justify-between gap-6 border-b border-[#5AC8F4]/12 pb-6\" data-kid=\"1-3-1-1\" data-name=\"common issues section header\">\n                <div data-kid=\"1-3-1-1-1\" data-name=\"section header title group\">\n                    <h2 class=\"text-[30px] font-semibold tracking-tight\" data-kid=\"1-3-1-1-1-1\" data-name=\"section header headline\">\n                        Common issues we can help with\n                    </h2>\n                    <p class=\"mt-2.5 max-w-[620px] text-[14.5px] leading-relaxed text-[#AFC0D2]\" data-kid=\"1-3-1-1-1-2\" data-name=\"section header description\">\n                        Pick the closest match — it fills in item\n                        <span class=\"font-code text-[#5AC8F4]\" data-kid=\"1-3-1-1-1-2-1\" data-name=\"highlighted item ref '1.'\">\n                            1.\n                        </span>\n                        of your request. If none fit, choose “Something else” and describe it in your own words.\n                    </p>\n                </div>\n                <div class=\"rule-wash hidden h-px w-40 rounded-full lg:block\" data-kid=\"1-3-1-1-2\" data-name=\"decorative gradient rule divider\">\n                </div>\n            </div>\n            <div class=\"reveal cat-grid mt-8\" data-kid=\"1-3-1-2\" data-name=\"issue category card grid\">\n                <button class=\"cat-card mb-4 block w-full break-inside-avoid rounded-md p-5 text-left\" data-issue=\"Transaction pending or delayed\" data-kid=\"1-3-1-2-1\" data-name=\"issue category card — Transaction pending/false\" type=\"button\">\n                    <i class=\"icon-clock text-[18px] text-[#5AC8F4]\" data-kid=\"1-3-1-2-1-1\" data-name=\"clock icon (pending card)\">\n                    </i>\n                    <span class=\"mt-3.5 block text-[15px] font-semibold\" data-kid=\"1-3-1-2-1-2\" data-name=\"card title — Transaction pending or delayed\">\n                        Transaction pending or delayed\n                    </span>\n                    <span class=\"mt-1.5 block text-[13px] leading-snug text-[#9DB0C4]\" data-kid=\"1-3-1-2-1-3\" data-name=\"card description — stuck transaction\">\n                        A send has been stuck for a while and has not confirmed yet.\n                    </span>\n                </button>\n                <button class=\"cat-card mb-4 block w-full break-inside-avoid rounded-md p-5 text-left\" data-issue=\"RPC or node connection error\" data-kid=\"1-3-1-2-2\" data-name=\"issue category card — RPC error\" type=\"button\">\n                    <i class=\"icon-server text-[18px] text-[#5AC8F4]\" data-kid=\"1-3-1-2-2-1\" data-name=\"server icon (RPC card)\">\n                    </i>\n                    <span class=\"mt-3.5 block text-[15px] font-semibold\" data-kid=\"1-3-1-2-2-2\" data-name=\"card title — RPC or node connection error\">\n                        RPC or node connection error\n                    </span>\n                    <span class=\"mt-1.5 block text-[13px] leading-snug text-[#9DB0C4]\" data-kid=\"1-3-1-2-2-3\" data-name=\"card description — wallet cannot reach network\">\n                        Your wallet cannot reach the network, or requests keep timing out.\n                    </span>\n                </button>\n                <button class=\"cat-card mb-4 block w-full break-inside-avoid rounded-md p-5 text-left\" data-issue=\"Swap slippage\" data-kid=\"1-3-1-2-3\" data-name=\"issue category card — Swap slippage\" type=\"button\">\n                    <i class=\"icon-arrow-down-up text-[18px] text-[#5AC8F4]\" data-kid=\"1-3-1-2-3-1\" data-name=\"arrow-down-up icon (slippage card)\">\n                    </i>\n                    <span class=\"mt-3.5 block text-[15px] font-semibold\" data-kid=\"1-3-1-2-3-2\" data-name=\"card title — Swap slippage\">\n                        Swap slippage\n                    </span>\n                    <span class=\"mt-1.5 block text-[13px] leading-snug text-[#9DB0C4]\" data-kid=\"1-3-1-2-3-3\" data-name=\"card description — price moved or route refused\">\n                        A swap price moved past your limit or the route refused to fill.\n                    </span>\n                </button>\n                <button class=\"cat-card mb-4 block w-full break-inside-avoid rounded-md p-5 text-left\" data-issue=\"Bridge transfer not arrived\" data-kid=\"1-3-1-2-4\" data-name=\"issue category card — Bridge transfer\" type=\"button\">\n                    <i class=\"icon-shuffle text-[18px] text-[#5AC8F4]\" data-kid=\"1-3-1-2-4-1\" data-name=\"shuffle icon (bridge card)\">\n                    </i>\n                    <span class=\"mt-3.5 block text-[15px] font-semibold\" data-kid=\"1-3-1-2-4-2\" data-name=\"card title — Bridge transfer not arrived\">\n                        Bridge transfer not arrived\n                    </span>\n                    <span class=\"mt-1.5 block text-[13px] leading-snug text-[#9DB0C4]\" data-kid=\"1-3-1-2-4-3\" data-name=\"card description — funds not landed\">\n                        Funds left one chain but have not landed on the destination chain.\n                    </span>\n                </button>\n                <button class=\"cat-card mb-4 block w-full break-inside-avoid rounded-md p-5 text-left\" data-issue=\"Missing or incorrect balance\" data-kid=\"1-3-1-2-5\" data-name=\"issue category card — Missing balance\" type=\"button\">\n                    <i class=\"icon-wallet text-[18px] text-[#5AC8F4]\" data-kid=\"1-3-1-2-5-1\" data-name=\"wallet icon (balance card)\">\n                    </i>\n                    <span class=\"mt-3.5 block text-[15px] font-semibold\" data-kid=\"1-3-1-2-5-2\" data-name=\"card title — Missing or incorrect balance\">\n                        Missing or incorrect balance\n                    </span>\n                    <span class=\"mt-1.5 block text-[13px] leading-snug text-[#9DB0C4]\" data-kid=\"1-3-1-2-5-3\" data-name=\"card description — token shows different amount\">\n                        A token shows a different amount than the explorer reports.\n                    </span>\n                </button>\n                <button class=\"cat-card mb-4 block w-full break-inside-avoid rounded-md p-5 text-left\" data-issue=\"Token approval stuck\" data-kid=\"1-3-1-2-6\" data-name=\"issue category card — Token approval stuck\" type=\"button\">\n                    <i class=\"icon-lock text-[18px] text-[#5AC8F4]\" data-kid=\"1-3-1-2-6-1\" data-name=\"lock icon (approval card)\">\n                    </i>\n                    <span class=\"mt-3.5 block text-[15px] font-semibold\" data-kid=\"1-3-1-2-6-2\" data-name=\"card title — Token approval stuck\">\n                        Token approval stuck\n                    </span>\n                    <span class=\"mt-1.5 block text-[13px] leading-snug text-[#9DB0C4]\" data-kid=\"1-3-1-2-6-3\" data-name=\"card description — approval not complete\">\n                        An approval transaction will not complete or keeps requesting again.\n                    </span>\n                </button>\n                <button class=\"cat-card mb-4 block w-full break-inside-avoid rounded-md p-5 text-left\" data-issue=\"Failed contract interaction\" data-kid=\"1-3-1-2-7\" data-name=\"issue category card — Failed contract\" type=\"button\">\n                    <i class=\"icon-triangle-alert text-[18px] text-[#5AC8F4]\" data-kid=\"1-3-1-2-7-1\" data-name=\"triangle-alert icon (failed contract card)\">\n                    </i>\n                    <span class=\"mt-3.5 block text-[15px] font-semibold\" data-kid=\"1-3-1-2-7-2\" data-name=\"card title — Failed contract interaction\">\n                        Failed contract interaction\n                    </span>\n                    <span class=\"mt-1.5 block text-[13px] leading-snug text-[#9DB0C4]\" data-kid=\"1-3-1-2-7-3\" data-name=\"card description — call reverted\">\n                        A call reverted and you need help reading what the error means.\n                    </span>\n                </button>\n                <button class=\"cat-card mb-4 block w-full break-inside-avoid rounded-md p-5 text-left\" data-issue=\"Wrong network selected\" data-kid=\"1-3-1-2-8\" data-name=\"issue category card — Wrong network\" type=\"button\">\n                    <i class=\"icon-network text-[18px] text-[#5AC8F4]\" data-kid=\"1-3-1-2-8-1\" data-name=\"network icon (wrong network card)\">\n                    </i>\n                    <span class=\"mt-3.5 block text-[15px] font-semibold\" data-kid=\"1-3-1-2-8-2\" data-name=\"card title — Wrong network selected\">\n                        Wrong network selected\n                    </span>\n                    <span class=\"mt-1.5 block text-[13px] leading-snug text-[#9DB0C4]\" data-kid=\"1-3-1-2-8-3\" data-name=\"card description — sent on different chain\">\n                        Sent or viewed on one chain while the app expected another.\n                    </span>\n                </button>\n                <button class=\"cat-card mb-4 block w-full break-inside-avoid rounded-md p-5 text-left\" data-issue=\"Staking or withdrawal issue\" data-kid=\"1-3-1-2-9\" data-name=\"issue category card — Staking/withdrawal\" type=\"button\">\n                    <i class=\"icon-coins text-[18px] text-[#5AC8F4]\" data-kid=\"1-3-1-2-9-1\" data-name=\"coins icon (staking card)\">\n                    </i>\n                    <span class=\"mt-3.5 block text-[15px] font-semibold\" data-kid=\"1-3-1-2-9-2\" data-name=\"card title — Staking or withdrawal issue\">\n                        Staking or withdrawal issue\n                    </span>\n                    <span class=\"mt-1.5 block text-[13px] leading-snug text-[#9DB0C4]\" data-kid=\"1-3-1-2-9-3\" data-name=\"card description — rewards or unstake not returned\">\n                        Rewards are not showing, or an unstake request has not returned.\n                    </span>\n                </button>\n                <button class=\"cat-card mb-4 block w-full break-inside-avoid rounded-md p-5 text-left\" data-issue=\"NFT transfer issue\" data-kid=\"1-3-1-2-10\" data-name=\"issue category card — NFT transfer\" type=\"button\">\n                    <i class=\"icon-image text-[18px] text-[#5AC8F4]\" data-kid=\"1-3-1-2-10-1\" data-name=\"image icon (NFT card)\">\n                    </i>\n                    <span class=\"mt-3.5 block text-[15px] font-semibold\" data-kid=\"1-3-1-2-10-2\" data-name=\"card title — NFT transfer issue\">\n                        NFT transfer issue\n                    </span>\n                    <span class=\"mt-1.5 block text-[13px] leading-snug text-[#9DB0C4]\" data-kid=\"1-3-1-2-10-3\" data-name=\"card description — item missing after transfer\">\n                        An item is missing from your collection view after a transfer.\n                    </span>\n                </button>\n                <button class=\"cat-card mb-4 block w-full break-inside-avoid rounded-md p-5 text-left\" data-issue=\"Exchange deposit missing\" data-kid=\"1-3-1-2-11\" data-name=\"issue category card — Exchange deposit\" type=\"button\">\n                    <i class=\"icon-landmark text-[18px] text-[#5AC8F4]\" data-kid=\"1-3-1-2-11-1\" data-name=\"landmark icon (exchange deposit card)\">\n                    </i>\n                    <span class=\"mt-3.5 block text-[15px] font-semibold\" data-kid=\"1-3-1-2-11-2\" data-name=\"card title — Exchange deposit missing\">\n                        Exchange deposit missing\n                    </span>\n                    <span class=\"mt-1.5 block text-[13px] leading-snug text-[#9DB0C4]\" data-kid=\"1-3-1-2-11-3\" data-name=\"card description — deposit not credited\">\n                        A deposit left your wallet but has not been credited to your account.\n                    </span>\n                </button>\n                <button class=\"cat-card mb-4 block w-full break-inside-avoid rounded-md p-5 text-left\" data-issue=\"Something else\" data-kid=\"1-3-1-2-12\" data-name=\"issue category card — Something else\" type=\"button\">\n                    <i class=\"icon-circle-help text-[18px] text-[#5AC8F4]\" data-kid=\"1-3-1-2-12-1\" data-name=\"circle-help icon (something else card)\">\n                    </i>\n                    <span class=\"mt-3.5 block text-[15px] font-semibold\" data-kid=\"1-3-1-2-12-2\" data-name=\"card title — Something else\">\n                        Something else\n                    </span>\n                    <span class=\"mt-1.5 block text-[13px] leading-snug text-[#9DB0C4]\" data-kid=\"1-3-1-2-12-3\" data-name=\"card description — describe in step 4\">\n                        Not listed above? Choose this and describe the problem in step 4.\n                    </span>\n                </button>\n            </div>\n        </div>\n    </section>\n    <!-- ================= CONTACT ================= -->\n    <section class=\"mx-auto max-w-[1180px] px-8 py-16\" data-kid=\"1-4\" data-name=\"contact section\" id=\"contact\">\n        <div class=\"reveal grid grid-cols-12 gap-8 rounded-md border border-[#5AC8F4]/14 bg-[#22323F]/60 p-8 md:p-10\" data-kid=\"1-4-1\" data-name=\"contact card layout\">\n            <div class=\"col-span-12 md:col-span-7\" data-kid=\"1-4-1-1\" data-name=\"contact left column\">\n                <h2 class=\"text-[26px] font-semibold tracking-tight\" data-kid=\"1-4-1-1-1\" data-name=\"contact headline\">\n                    Already have the details? Write to us directly.\n                </h2>\n                <p class=\"mt-3 max-w-[560px] text-[14.5px] leading-relaxed text-[#AFC0D2]\" data-kid=\"1-4-1-1-2\" data-name=\"contact description text\">\n                    If you would rather write the message yourself, use the address below. Include the network, the public transaction hash if you have one, and what you expected to happen — the more specific the detail, the easier the issue is to trace.\n                </p>\n                <div class=\"mt-6 flex flex-wrap items-center gap-3\" data-kid=\"1-4-1-1-3\" data-name=\"contact action buttons row\">\n                    <a class=\"flex items-center gap-2.5 rounded-sm bg-[#5AC8F4] px-5 py-3 text-[14px] font-semibold text-[#0F1C28] hover:bg-[#7AD6F8]\" data-kid=\"1-4-1-1-3-1\" data-name=\"email address CTA button (mailto)\" href=\"mailto:Willsmith199425@gmail.com\">\n                        <i class=\"icon-mail text-[15px]\" data-kid=\"1-4-1-1-3-1-1\" data-name=\"mail icon (email CTA)\">\n                        </i>\n                        Willsmith199425@gmail.com\n                    </a>\n                    <button class=\"flex items-center gap-2 rounded-sm border border-[#5AC8F4]/30 px-4 py-3 text-[14px] text-[#CBD8E4] hover:border-[#5AC8F4]/60\" data-kid=\"1-4-1-1-3-2\" data-name=\"copy email address button\" id=\"copyMail\" type=\"button\">\n                        <i class=\"icon-copy text-[14px]\" data-kid=\"1-4-1-1-3-2-1\" data-name=\"copy icon (copy button)\">\n                        </i>\n                        <span data-dynamic=\"true\" data-kid=\"1-4-1-1-3-2-2\" data-name=\"copy button label (toggles to 'Copied' on click)\" data-reason=\"text replaced by click handler then restored after 1.8s\" id=\"copyLabel\">\n                            Copy address\n                        </span>\n                    </button>\n                </div>\n            </div>\n            <div class=\"col-span-12 md:col-span-5\" data-kid=\"1-4-1-2\" data-name=\"contact right column\">\n                <div class=\"well rounded-sm p-6\" data-kid=\"1-4-1-2-1\" data-name=\"before you send panel\">\n                    <h3 class=\"text-[15px] font-semibold\" data-kid=\"1-4-1-2-1-1\" data-name=\"before you send heading\">\n                        Before you send\n                    </h3>\n                    <ul class=\"mt-4 space-y-3 text-[13.5px] leading-relaxed text-[#AFC0D2]\" data-kid=\"1-4-1-2-1-2\" data-name=\"before you send checklist\">\n                        <li class=\"flex gap-3\" data-kid=\"1-4-1-2-1-2-1\" data-name=\"checklist item 1 (public info OK)\">\n                            <i class=\"icon-circle-check mt-0.5 shrink-0 text-[15px] text-[#5AC8F4]\" data-kid=\"1-4-1-2-1-2-1-1\" data-name=\"circle-check icon (allowed)\">\n                            </i>\n                            <span data-kid=\"1-4-1-2-1-2-1-2\" data-name=\"checklist item 1 text\">\n                                Public addresses and transaction hashes are fine to include.\n                            </span>\n                        </li>\n                        <li class=\"flex gap-3\" data-kid=\"1-4-1-2-1-2-2\" data-name=\"checklist item 2 (never include private key)\">\n                            <i class=\"icon-circle-x mt-0.5 shrink-0 text-[15px] text-[#8DA1B7]\" data-kid=\"1-4-1-2-1-2-2-1\" data-name=\"circle-x icon (not allowed)\">\n                            </i>\n                            <span data-kid=\"1-4-1-2-1-2-2-2\" data-name=\"checklist item 2 text\">\n                                Never include a seed phrase, private key, or a screenshot of either.\n                            </span>\n                        </li>\n                        <li class=\"flex gap-3\" data-kid=\"1-4-1-2-1-2-3\" data-name=\"checklist item 3 (keep it specific)\">\n                            <i class=\"icon-circle-check mt-0.5 shrink-0 text-[15px] text-[#5AC8F4]\" data-kid=\"1-4-1-2-1-2-3-1\" data-name=\"circle-check icon (allowed)\">\n                            </i>\n                            <span data-kid=\"1-4-1-2-1-2-3-2\" data-name=\"checklist item 3 text\">\n                                Keep it specific: what you did, what you expected, what happened instead.\n                            </span>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= FOOTER ================= -->\n    <footer class=\"border-t border-[#5AC8F4]/12 bg-[#192734]\" data-kid=\"1-5\" data-name=\"site footer\">\n        <div class=\"mx-auto flex max-w-[1180px] flex-col gap-6 px-8 py-9 md:flex-row md:items-center md:justify-between\" data-kid=\"1-5-1\" data-name=\"footer top row\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-5-1-1\" data-name=\"footer brand block\">\n                <span class=\"flex h-8 w-8 items-center justify-center rounded-sm border border-[#5AC8F4]/25 bg-[#16222F] text-[16px] text-[#5AC8F4]\" data-kid=\"1-5-1-1-1\" data-name=\"footer logo icon badge (shield-check)\">\n                    <i class=\"icon-shield-check\" data-kid=\"1-5-1-1-1-1\" data-name=\"shield-check icon (footer)\">\n                    </i>\n                </span>\n                <span class=\"text-[13.5px] text-[#8DA1B7]\" data-kid=\"1-5-1-1-2\" data-name=\"footer brand text\">\n                    Asset RPC Support —\n                    <span class=\"font-code text-[12.5px] text-[#AFC0D2]\" data-kid=\"1-5-1-1-2-1\" data-name=\"footer email address text\">\n                        Willsmith199425@gmail.com\n                    </span>\n                </span>\n            </div>\n            <div class=\"flex flex-wrap items-center gap-x-6 gap-y-2 text-[13px] text-[#8DA1B7]\" data-kid=\"1-5-1-2\" data-name=\"footer links and copyright\">\n                <a class=\"hover:text-[#E8F0F6]\" data-kid=\"1-5-1-2-1\" data-name=\"footer nav link — start a request\" href=\"#request\">\n                    Start a request\n                </a>\n                <a class=\"hover:text-[#E8F0F6]\" data-kid=\"1-5-1-2-2\" data-name=\"footer nav link — common issues\" href=\"#issues\">\n                    Common issues\n                </a>\n                <a class=\"hover:text-[#E8F0F6]\" data-kid=\"1-5-1-2-3\" data-name=\"footer nav link — contact\" href=\"#contact\">\n                    Contact\n                </a>\n                <span class=\"text-[#9DB0C4]\" data-kid=\"1-5-1-2-4\" data-name=\"footer copyright text\">\n                    © 2026 Asset RPC\n                </span>\n            </div>\n        </div>\n        <div class=\"border-t border-[#5AC8F4]/10\" data-kid=\"1-5-2\" data-name=\"footer disclaimer bar\">\n            <p class=\"mx-auto max-w-[1180px] px-8 py-4 text-[12.5px] leading-relaxed text-[#9DB0C4]\" data-kid=\"1-5-2-1\" data-name=\"disclaimer text\">\n                Asset RPC is an independent support service. We are not affiliated with any wallet provider or exchange. We will never ask for your seed phrase, private keys, or for you to move funds on our behalf.\n            </p>\n        </div>\n    </footer>\n</div>\n<script>\n    (function () {\n    var fType = document.getElementById('fType');\n    var fNet = document.getElementById('fNet');\n    var fHash = document.getElementById('fHash');\n    var fDesc = document.getElementById('fDesc');\n    var pvType = document.getElementById('pvType');\n    var pvNet = document.getElementById('pvNet');\n    var pvHash = document.getElementById('pvHash');\n    var pvDesc = document.getElementById('pvDesc');\n    var pvSubj = document.getElementById('pvSubj');\n    var EMAIL = 'Willsmith199425@gmail.com';\n\n    function sync() {\n      pvType.textContent = fType.value || 'not selected';\n      pvSubj.textContent = fType.value || 'Support request';\n      pvNet.textContent = fNet.value || 'not selected';\n      var h = fHash.value.trim();\n      pvHash.textContent = h ? h : 'not provided';\n      pvDesc.textContent = fDesc.value.trim() || 'your description appears here as you type';\n      pvDesc.classList.toggle('italic', !fDesc.value.trim());\n    }\n\n    function openDraft() {\n      var subject = 'Asset RPC support — ' + (fType.value || 'Support request');\n      var body = [\n        '1. Issue type: ' + (fType.value || 'Not specified'),\n        '2. Network: ' + (fNet.value || 'Not specified'),\n        '3. Transaction hash: ' + (fHash.value.trim() || 'Not provided'),\n        '4. Issue description: ' + (fDesc.value.trim() || 'Not provided'),\n        '',\n        'Sent from the Asset RPC support portal.'\n      ].join('\\n');\n      window.location.href = 'mailto:' + EMAIL +\n        '?subject=' + encodeURIComponent(subject) +\n        '&body=' + encodeURIComponent(body);\n    }\n\n    [fType, fNet, fHash, fDesc].forEach(function (el) {\n      el.addEventListener('input', sync);\n      el.addEventListener('change', sync);\n    });\n    document.getElementById('openDraft').addEventListener('click', openDraft);\n    document.getElementById('openInMail').addEventListener('click', openDraft);\n    sync();\n\n    /* issue category -> prefill step 1 */\n    document.querySelectorAll('.cat-card').forEach(function (card) {\n      card.addEventListener('click', function () {\n        fType.value = card.getAttribute('data-issue');\n        document.querySelectorAll('.cat-card.is-active').forEach(function (c) { c.classList.remove('is-active'); });\n        card.classList.add('is-active');\n        sync();\n        document.getElementById('request').scrollIntoView({ behavior: 'smooth', block: 'start' });\n      });\n    });\n\n    /* copy email address */\n    var copyBtn = document.getElementById('copyMail');\n    copyBtn.addEventListener('click', function () {\n      var done = function () {\n        document.getElementById('copyLabel').textContent = 'Copied';\n        setTimeout(function () { document.getElementById('copyLabel').textContent = 'Copy address'; }, 1800);\n      };\n      if (navigator.clipboard && navigator.clipboard.writeText) {\n        navigator.clipboard.writeText(EMAIL).then(done, done);\n      } else { done(); }\n    });\n  })();\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n  document.querySelectorAll('.reveal').forEach(function (el) {\n    gsap.from(el, {\n      y: 22,\n      opacity: 0,\n      duration: 0.7,\n      ease: 'power2.out',\n      scrollTrigger: { trigger: el, start: 'top 88%' }\n    });\n  });\n</script>\n",
      "comments": [],
      "created": "2026-10-21T11:48:17.355608+00:00",
      "modified": "2026-10-21T12:00:45.896550+00:00",
      "id": "var_c6359c973108",
      "contentHeight": 2436
    },
    "var_fbefa6ea46f6": {
      "type": "variant",
      "label": "ChainCare — Help Terminal",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Exo+2:wght@400;500;600;700&family=Yantramanav:wght@300;400;500;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n  @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n\n  .f-exo { font-family: 'Exo 2', sans-serif; }\n  .f-body { font-family: 'Yantramanav', sans-serif; }\n  .f-mono { font-family: 'IBM Plex Mono', monospace; }\n\n  .bg-grid {\n    background-image:\n      linear-gradient(rgba(72,124,255,0.045) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(72,124,255,0.045) 1px, transparent 1px);\n    background-size: 52px 52px;\n  }\n  .glow {\n    background-color: #080D19;\n    background-image:\n      radial-gradient(720px 420px at 18% -6%, rgba(47,107,255,0.20), transparent 70%),\n      radial-gradient(680px 420px at 88% 4%, rgba(28,88,196,0.16), transparent 72%),\n      radial-gradient(900px 500px at 50% 108%, rgba(30,64,132,0.22), transparent 70%),\n      linear-gradient(rgba(72,124,255,0.05) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(72,124,255,0.05) 1px, transparent 1px);\n    background-size: auto, auto, auto, 52px 52px, 52px 52px;\n  }\n  .cut { clip-path: polygon(11px 0, 100% 0, 100% calc(100% - 11px), calc(100% - 11px) 100%, 0 100%, 0 11px); }\n  .cut-sm { clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px); }\n  .cut-btn { clip-path: polygon(9px 0, 100% 0, 100% calc(100% - 9px), calc(100% - 9px) 100%, 0 100%, 0 9px); }\n  .plate {\n    box-shadow: inset 0 1px 0 rgba(255,255,255,0.05), 0 18px 40px -22px rgba(0,0,0,0.95);\n  }\n  .inset-rim { box-shadow: inset 0 1px 0 rgba(255,255,255,0.045), inset 0 0 0 1px rgba(90,140,255,0.04); }\n  .stripes {\n    background-image: repeating-linear-gradient(115deg, rgba(255,255,255,0.05) 0 1px, transparent 1px 9px);\n  }\n  ::selection { background: #2f6bff; color: #fff; }\n  select option { background: #0e1728; color: #e6edf9; }\n  .scroll-thin::-webkit-scrollbar { width: 8px; }\n  .scroll-thin::-webkit-scrollbar-thumb { background: #21314f; }\n</style>\n<div class=\"f-body glow min-h-screen w-full overflow-x-clip bg-[#080D19] text-[#DDE6F5] antialiased\" data-kid=\"1\" data-name=\"page root container with dark grid glow\">\n    <!-- ================= TOP BAR ================= -->\n    <header class=\"gsap-bar sticky top-0 z-40 border-b border-[#16233c] bg-[#0A1122]/92 backdrop-blur-xl\" data-kid=\"1-1\" data-name=\"top navigation header bar\">\n        <div class=\"mx-auto flex h-[68px] w-full max-w-[1400px] items-center gap-6 px-6\" data-kid=\"1-1-1\" data-name=\"header row container\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand logo container\">\n                <div class=\"cut-sm relative flex h-9 w-9 items-center justify-center bg-[#12203a] p-px\" data-kid=\"1-1-1-1-1\" data-name=\"logo badge outer frame\">\n                    <div class=\"cut-sm flex h-full w-full items-center justify-center bg-[#2f6bff]\" data-kid=\"1-1-1-1-1-1\" data-name=\"logo badge inner plate\">\n                        <i class=\"ti ti-link text-[19px] text-white\" data-kid=\"1-1-1-1-1-1-1\" data-name=\"link chain logo icon\">\n                        </i>\n                    </div>\n                </div>\n                <div class=\"leading-none\" data-kid=\"1-1-1-1-2\" data-name=\"brand text block\">\n                    <div class=\"f-exo text-[17px] font-700 tracking-tight text-[#F2F6FF]\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand name text\">\n                        Asset RPC\n                    </div>\n                    <div class=\"mt-1 text-[11px] font-400 tracking-[0.16em] text-[#7e90ad]\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand domain subtitle\">\n                        https://asset-rpc.netlify\n                    </div>\n                </div>\n            </div>\n            <nav class=\"ml-4 hidden items-center gap-1 border border-[#16233c] bg-[#0C1424] p-1 lg:flex\" data-kid=\"1-1-1-2\" data-name=\"main navigation tabs\">\n                <span class=\"cut-btn bg-[#1B2A47] px-4 py-1.5 text-[13px] font-500 text-[#DCE7FA]\" data-kid=\"1-1-1-2-1\" data-name=\"new request active tab\">\n                    New request\n                </span>\n                <a class=\"cut-btn px-4 py-1.5 text-[13px] font-400 text-[#8fa2bf] hover:text-[#DCE7FA]\" data-kid=\"1-1-1-2-2\" data-name=\"troubleshooting tab link\" href=\"#fixes\">\n                    Troubleshooting\n                </a>\n                <a class=\"cut-btn px-4 py-1.5 text-[13px] font-400 text-[#8fa2bf] hover:text-[#DCE7FA]\" data-kid=\"1-1-1-2-3\" data-name=\"safety tab link\" href=\"#safety\">\n                    Safety\n                </a>\n            </nav>\n            <div class=\"ml-auto flex items-center gap-3\" data-kid=\"1-1-1-3\" data-name=\"header right side controls\">\n                <div class=\"hidden items-center gap-2 border border-[#16233c] bg-[#0C1424] px-3 py-2 md:flex\" data-kid=\"1-1-1-3-1\" data-name=\"support email display badge\">\n                    <i class=\"ti ti-mail text-[15px] text-[#5d8dff]\" data-kid=\"1-1-1-3-1-1\" data-name=\"email icon\">\n                    </i>\n                    <span class=\"f-mono text-[12px] text-[#b8c8e2]\" data-kid=\"1-1-1-3-1-2\" data-name=\"support email address text\">\n                        Willsmith199425@gmail.com\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-2 border border-[#1b3560] bg-[#0B1B33] px-3 py-2\" data-kid=\"1-1-1-3-2\" data-name=\"no-wallet-login disclaimer badge\">\n                    <i class=\"ti ti-file-text text-[14px] text-[#5d8dff]\" data-kid=\"1-1-1-3-2-1\" data-name=\"file document icon\">\n                    </i>\n                    <span class=\"text-[12px] font-500 text-[#a9c3e4]\" data-kid=\"1-1-1-3-2-2\" data-name=\"email draft disclaimer text\">\n                        Email draft only · No wallet login\n                    </span>\n                </div>\n            </div>\n        </div>\n    </header>\n    <main class=\"relative mx-auto w-full max-w-[1400px] px-6 pt-9 pb-16\" data-kid=\"1-2\" data-name=\"main content wrapper\">\n        <!-- ================= TITLE ================= -->\n        <div class=\"gsap-head mb-7 flex flex-wrap items-end justify-between gap-6 border-b border-[#16233c] pb-6\" data-kid=\"1-2-1\" data-name=\"page title header row\">\n            <div class=\"max-w-2xl\" data-kid=\"1-2-1-1\" data-name=\"title text group\">\n                <h1 class=\"f-exo text-[34px] leading-[1.1] font-700 tracking-tight text-[#F4F8FF]\" data-kid=\"1-2-1-1-1\" data-name=\"page headline text\">\n                    Tell us what went wrong\n                </h1>\n                <p class=\"mt-3 text-[15px] leading-relaxed text-[#8fa2bf]\" data-kid=\"1-2-1-1-2\" data-name=\"page subheadline description\">\n                    Fill the four fields below. Asset RPC turns your answers into a numbered email draft addressed to support, and you send it from your own mail app.\n                </p>\n            </div>\n            <div class=\"flex flex-wrap items-center gap-x-4 gap-y-2 pb-1 text-[13.5px] text-[#93A6C2]\" data-kid=\"1-2-1-2\" data-name=\"meta badge group\">\n                <span class=\"flex items-center gap-2\" data-kid=\"1-2-1-2-1\" data-name=\"answers count badge\">\n                    <i class=\"ti ti-list-numbers text-[15px] text-[#5d8dff]\" data-kid=\"1-2-1-2-1-1\" data-name=\"numbered list icon\">\n                    </i>\n                    4 numbered answers\n                </span>\n                <span class=\"h-4 w-px bg-[#22314f]\" data-kid=\"1-2-1-2-2\" data-name=\"vertical divider line\">\n                </span>\n                <span class=\"flex items-center gap-2\" data-kid=\"1-2-1-2-3\" data-name=\"time estimate badge\">\n                    <i class=\"ti ti-clock text-[15px] text-[#5d8dff]\" data-kid=\"1-2-1-2-3-1\" data-name=\"clock icon\">\n                    </i>\n                    about 2 minutes\n                </span>\n            </div>\n        </div>\n        <!-- ================= THREE COLUMN WORKSPACE ================= -->\n        <div class=\"grid grid-cols-1 gap-4 lg:grid-cols-[268px_minmax(0,1fr)_336px]\" data-kid=\"1-2-2\" data-name=\"three column workspace grid\">\n            <!-- LEFT: issue type chooser -->\n            <aside class=\"gsap-col-1 plate cut self-start bg-[#152341] p-px\" data-kid=\"1-2-2-1\" data-name=\"issue type chooser panel\">\n                <div class=\"cut bg-[#0D1626] p-4\" data-kid=\"1-2-2-1-1\" data-name=\"issue type panel inner container\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-2-2-1-1-1\" data-name=\"issue type panel header row\">\n                        <h2 class=\"f-exo text-[14px] font-600 tracking-wide text-[#DCE7FA]\" data-kid=\"1-2-2-1-1-1-1\" data-name=\"issue type panel title\">\n                            Issue type\n                        </h2>\n                    </div>\n                    <p class=\"mt-1.5 text-[12.5px] leading-snug text-[#93A6C2]\" data-kid=\"1-2-2-1-1-2\" data-name=\"issue type panel description\">\n                        Pick the closest match. You can describe nuance in the details field.\n                    </p>\n                    <div class=\"mt-4 flex flex-col gap-1.5\" data-kid=\"1-2-2-1-1-3\" data-name=\"issue type button list\" id=\"typeList\">\n                        <button class=\"type-btn cut-btn flex w-full items-center gap-2.5 border border-[#1c2c48] bg-[#101B2E] px-2.5 py-2 text-left transition-colors hover:border-[#2b4d86] hover:bg-[#12203a]\" data-kid=\"1-2-2-1-1-3-1\" data-name=\"transaction stuck type select button\" data-type=\"Transaction stuck or pending\">\n                            <i class=\"ti ti-clock-pause text-[17px] text-[#5d8dff]\" data-kid=\"1-2-2-1-1-3-1-1\" data-name=\"clock pause icon\">\n                            </i>\n                            <span class=\"truncate text-[13px] font-500 text-[#c3d2e8]\" data-kid=\"1-2-2-1-1-3-1-2\" data-name=\"transaction stuck label\">\n                                Transaction stuck\n                            </span>\n                        </button>\n                        <button class=\"type-btn cut-btn flex w-full items-center gap-2.5 border border-[#1c2c48] bg-[#101B2E] px-2.5 py-2 text-left transition-colors hover:border-[#2b4d86] hover:bg-[#12203a]\" data-kid=\"1-2-2-1-1-3-2\" data-name=\"failed transaction type select button\" data-type=\"Transaction failed\">\n                            <i class=\"ti ti-alert-triangle text-[17px] text-[#5d8dff]\" data-kid=\"1-2-2-1-1-3-2-1\" data-name=\"alert triangle icon\">\n                            </i>\n                            <span class=\"truncate text-[13px] font-500 text-[#c3d2e8]\" data-kid=\"1-2-2-1-1-3-2-2\" data-name=\"failed transaction label\">\n                                Failed transaction\n                            </span>\n                        </button>\n                        <button class=\"type-btn cut-btn flex w-full items-center gap-2.5 border border-[#1c2c48] bg-[#101B2E] px-2.5 py-2 text-left transition-colors hover:border-[#2b4d86] hover:bg-[#12203a]\" data-kid=\"1-2-2-1-1-3-3\" data-name=\"RPC node error type select button\" data-type=\"RPC or node connection error\">\n                            <i class=\"ti ti-server-2 text-[17px] text-[#5d8dff]\" data-kid=\"1-2-2-1-1-3-3-1\" data-name=\"server icon\">\n                            </i>\n                            <span class=\"truncate text-[13px] font-500 text-[#c3d2e8]\" data-kid=\"1-2-2-1-1-3-3-2\" data-name=\"RPC node error label\">\n                                RPC or node error\n                            </span>\n                        </button>\n                        <button class=\"type-btn cut-btn flex w-full items-center gap-2.5 border border-[#1c2c48] bg-[#101B2E] px-2.5 py-2 text-left transition-colors hover:border-[#2b4d86] hover:bg-[#12203a]\" data-kid=\"1-2-2-1-1-3-4\" data-name=\"swap bridge error type select button\" data-type=\"Swap or bridge error\">\n                            <i class=\"ti ti-arrows-exchange text-[17px] text-[#5d8dff]\" data-kid=\"1-2-2-1-1-3-4-1\" data-name=\"arrows exchange icon\">\n                            </i>\n                            <span class=\"truncate text-[13px] font-500 text-[#c3d2e8]\" data-kid=\"1-2-2-1-1-3-4-2\" data-name=\"swap bridge error label\">\n                                Swap or bridge error\n                            </span>\n                        </button>\n                        <button class=\"type-btn cut-btn flex w-full items-center gap-2.5 border border-[#1c2c48] bg-[#101B2E] px-2.5 py-2 text-left transition-colors hover:border-[#2b4d86] hover:bg-[#12203a]\" data-kid=\"1-2-2-1-1-3-5\" data-name=\"exchange deposit type select button\" data-type=\"Exchange deposit or withdrawal\">\n                            <i class=\"ti ti-building-bank text-[17px] text-[#5d8dff]\" data-kid=\"1-2-2-1-1-3-5-1\" data-name=\"bank building icon\">\n                            </i>\n                            <span class=\"truncate text-[13px] font-500 text-[#c3d2e8]\" data-kid=\"1-2-2-1-1-3-5-2\" data-name=\"exchange deposit label\">\n                                Exchange deposit\n                            </span>\n                        </button>\n                        <button class=\"type-btn cut-btn flex w-full items-center gap-2.5 border border-[#1c2c48] bg-[#101B2E] px-2.5 py-2 text-left transition-colors hover:border-[#2b4d86] hover:bg-[#12203a]\" data-kid=\"1-2-2-1-1-3-6\" data-name=\"DApp connection type select button\" data-type=\"DApp or site connection problem\">\n                            <i class=\"ti ti-plug-off text-[17px] text-[#5d8dff]\" data-kid=\"1-2-2-1-1-3-6-1\" data-name=\"plug off icon\">\n                            </i>\n                            <span class=\"truncate text-[13px] font-500 text-[#c3d2e8]\" data-kid=\"1-2-2-1-1-3-6-2\" data-name=\"DApp connection label\">\n                                DApp connection\n                            </span>\n                        </button>\n                        <button class=\"type-btn cut-btn flex w-full items-center gap-2.5 border border-[#1c2c48] bg-[#101B2E] px-2.5 py-2 text-left transition-colors hover:border-[#2b4d86] hover:bg-[#12203a]\" data-kid=\"1-2-2-1-1-3-7\" data-name=\"staking question type select button\" data-type=\"Staking question\">\n                            <i class=\"ti ti-stack-2 text-[17px] text-[#5d8dff]\" data-kid=\"1-2-2-1-1-3-7-1\" data-name=\"stack icon\">\n                            </i>\n                            <span class=\"truncate text-[13px] font-500 text-[#c3d2e8]\" data-kid=\"1-2-2-1-1-3-7-2\" data-name=\"staking question label\">\n                                Staking question\n                            </span>\n                        </button>\n                        <button class=\"type-btn cut-btn flex w-full items-center gap-2.5 border border-[#1c2c48] bg-[#101B2E] px-2.5 py-2 text-left transition-colors hover:border-[#2b4d86] hover:bg-[#12203a]\" data-kid=\"1-2-2-1-1-3-8\" data-name=\"NFT mint transfer type select button\" data-type=\"NFT mint or transfer\">\n                            <i class=\"ti ti-diamond text-[17px] text-[#5d8dff]\" data-kid=\"1-2-2-1-1-3-8-1\" data-name=\"diamond icon\">\n                            </i>\n                            <span class=\"truncate text-[13px] font-500 text-[#c3d2e8]\" data-kid=\"1-2-2-1-1-3-8-2\" data-name=\"NFT mint transfer label\">\n                                NFT mint or transfer\n                            </span>\n                        </button>\n                        <button class=\"type-btn cut-btn flex w-full items-center gap-2.5 border border-[#1c2c48] bg-[#101B2E] px-2.5 py-2 text-left transition-colors hover:border-[#2b4d86] hover:bg-[#12203a]\" data-kid=\"1-2-2-1-1-3-9\" data-name=\"account sign-in type select button\" data-type=\"Account sign-in issue\">\n                            <i class=\"ti ti-user-circle text-[17px] text-[#5d8dff]\" data-kid=\"1-2-2-1-1-3-9-1\" data-name=\"user circle icon\">\n                            </i>\n                            <span class=\"truncate text-[13px] font-500 text-[#c3d2e8]\" data-kid=\"1-2-2-1-1-3-9-2\" data-name=\"account sign-in label\">\n                                Account sign-in\n                            </span>\n                        </button>\n                        <button class=\"type-btn cut-btn flex w-full items-center gap-2.5 border border-[#1c2c48] bg-[#101B2E] px-2.5 py-2 text-left transition-colors hover:border-[#2b4d86] hover:bg-[#12203a]\" data-kid=\"1-2-2-1-1-3-10\" data-name=\"something else type select button\" data-type=\"Something else\">\n                            <i class=\"ti ti-dots text-[17px] text-[#5d8dff]\" data-kid=\"1-2-2-1-1-3-10-1\" data-name=\"dots icon\">\n                            </i>\n                            <span class=\"truncate text-[13px] font-500 text-[#c3d2e8]\" data-kid=\"1-2-2-1-1-3-10-2\" data-name=\"something else label\">\n                                Something else\n                            </span>\n                        </button>\n                    </div>\n                    <div class=\"mt-4 border-t border-dashed border-[#1c2c48] pt-3\" data-kid=\"1-2-2-1-1-4\" data-name=\"no wallet login privacy footer\">\n                        <p class=\"text-[12.5px] leading-snug text-[#93A6C2]\" data-kid=\"1-2-2-1-1-4-1\" data-name=\"no wallet login privacy text\">\n                            No wallet login is needed. Asset RPC never asks for seed phrases or private keys.\n                        </p>\n                    </div>\n                </div>\n            </aside>\n            <!-- CENTER: intake form -->\n            <section class=\"gsap-col-2 plate cut bg-[#16264a] p-px\" data-kid=\"1-2-2-2\" data-name=\"support request form card\">\n                <div class=\"cut h-full bg-[#0C1524]\" data-kid=\"1-2-2-2-1\" data-name=\"support request form inner container\">\n                    <div class=\"flex items-center justify-between border-b border-[#16233c] bg-[#0E1728] px-5 py-4\" data-kid=\"1-2-2-2-1-1\" data-name=\"form header row\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"form title group\">\n                            <i class=\"ti ti-file-text text-[18px] text-[#5d8dff]\" data-kid=\"1-2-2-2-1-1-1-1\" data-name=\"file text icon\">\n                            </i>\n                            <h2 class=\"f-exo text-[16px] font-600 text-[#EAF1FF]\" data-kid=\"1-2-2-2-1-1-1-2\" data-name=\"form title text\">\n                                Support request\n                            </h2>\n                        </div>\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"form status badge group\">\n                            <span class=\"cut-btn bg-[#0F2036] px-2.5 py-1 text-[11px] font-500 tracking-wide text-[#8fb2e6] uppercase\" data-kid=\"1-2-2-2-1-1-2-1\" data-name=\"draft status badge\">\n                                Draft\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"relative px-5 pt-5 pb-5\" data-kid=\"1-2-2-2-1-2\" data-name=\"form body container\">\n                        <!-- 1 issue type -->\n                        <div class=\"mb-4\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"issue type form field\">\n                            <label class=\"mb-2 flex items-center gap-2\" data-kid=\"1-2-2-2-1-2-1-1\" data-name=\"issue type field label\">\n                                <span class=\"f-mono flex h-5 w-5 items-center justify-center bg-[#152B4C] text-[11px] text-[#8fb2e6]\" data-kid=\"1-2-2-2-1-2-1-1-1\" data-name=\"field number 1 badge\">\n                                    1\n                                </span>\n                                <span class=\"f-exo text-[13px] font-600 tracking-wide text-[#b9cbe6] uppercase\" data-kid=\"1-2-2-2-1-2-1-1-2\" data-name=\"issue type label text\">\n                                    Issue type\n                                </span>\n                            </label>\n                            <div class=\"relative\" data-kid=\"1-2-2-2-1-2-1-2\" data-name=\"issue type select wrapper\">\n                                <select class=\"f-body w-full appearance-none border border-[#1c2c48] bg-[#0F1A2C] px-3.5 py-3 pr-10 text-[14px] font-400 text-[#E6EDF9] outline-hidden focus:border-[#2f6bff]\" data-kid=\"1-2-2-2-1-2-1-2-1\" data-name=\"issue type select dropdown\" id=\"typeSelect\">\n                                    <option data-kid=\"1-2-2-2-1-2-1-2-1-1\" data-name=\"transaction stuck option\">\n                                        Transaction stuck or pending\n                                    </option>\n                                    <option data-kid=\"1-2-2-2-1-2-1-2-1-2\" data-name=\"failed transaction option\">\n                                        Transaction failed\n                                    </option>\n                                    <option data-kid=\"1-2-2-2-1-2-1-2-1-3\" data-name=\"RPC node error option\">\n                                        RPC or node connection error\n                                    </option>\n                                    <option data-kid=\"1-2-2-2-1-2-1-2-1-4\" data-name=\"swap bridge error option\">\n                                        Swap or bridge error\n                                    </option>\n                                    <option data-kid=\"1-2-2-2-1-2-1-2-1-5\" data-name=\"exchange deposit option\">\n                                        Exchange deposit or withdrawal\n                                    </option>\n                                    <option data-kid=\"1-2-2-2-1-2-1-2-1-6\" data-name=\"DApp connection option\">\n                                        DApp or site connection problem\n                                    </option>\n                                    <option data-kid=\"1-2-2-2-1-2-1-2-1-7\" data-name=\"staking question option\">\n                                        Staking question\n                                    </option>\n                                    <option data-kid=\"1-2-2-2-1-2-1-2-1-8\" data-name=\"NFT mint transfer option\">\n                                        NFT mint or transfer\n                                    </option>\n                                    <option data-kid=\"1-2-2-2-1-2-1-2-1-9\" data-name=\"account sign-in option\">\n                                        Account sign-in issue\n                                    </option>\n                                    <option data-kid=\"1-2-2-2-1-2-1-2-1-10\" data-name=\"something else option\">\n                                        Something else\n                                    </option>\n                                </select>\n                                <i class=\"ti ti-chevron-down pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-[16px] text-[#6d88b0]\" data-kid=\"1-2-2-2-1-2-1-2-2\" data-name=\"select dropdown chevron icon\">\n                                </i>\n                            </div>\n                        </div>\n                        <!-- 2 network -->\n                        <div class=\"mb-4\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"network form field\">\n                            <label class=\"mb-2 flex items-center gap-2\" data-kid=\"1-2-2-2-1-2-2-1\" data-name=\"network field label\">\n                                <span class=\"f-mono flex h-5 w-5 items-center justify-center bg-[#152B4C] text-[11px] text-[#8fb2e6]\" data-kid=\"1-2-2-2-1-2-2-1-1\" data-name=\"field number 2 badge\">\n                                    2\n                                </span>\n                                <span class=\"f-exo text-[13px] font-600 tracking-wide text-[#b9cbe6] uppercase\" data-kid=\"1-2-2-2-1-2-2-1-2\" data-name=\"network label text\">\n                                    Network\n                                </span>\n                            </label>\n                            <div class=\"relative\" data-kid=\"1-2-2-2-1-2-2-2\" data-name=\"network select wrapper\">\n                                <select class=\"f-body w-full appearance-none border border-[#1c2c48] bg-[#0F1A2C] px-3.5 py-3 pr-10 text-[14px] text-[#E6EDF9] outline-hidden focus:border-[#2f6bff]\" data-kid=\"1-2-2-2-1-2-2-2-1\" data-name=\"network select dropdown\" id=\"networkSelect\">\n                                    <option data-kid=\"1-2-2-2-1-2-2-2-1-1\" data-name=\"eth mainnet option\">\n                                        Ethereum Mainnet\n                                    </option>\n                                    <option data-kid=\"1-2-2-2-1-2-2-2-1-2\" data-name=\"base option\">\n                                        Base\n                                    </option>\n                                    <option data-kid=\"1-2-2-2-1-2-2-2-1-3\" data-name=\"arbitrum option\">\n                                        Arbitrum One\n                                    </option>\n                                    <option data-kid=\"1-2-2-2-1-2-2-2-1-4\" data-name=\"optimism option\">\n                                        Optimism\n                                    </option>\n                                    <option data-kid=\"1-2-2-2-1-2-2-2-1-5\" data-name=\"polygon option\">\n                                        Polygon\n                                    </option>\n                                    <option data-kid=\"1-2-2-2-1-2-2-2-1-6\" data-name=\"bnb chain option\">\n                                        BNB Chain\n                                    </option>\n                                    <option data-kid=\"1-2-2-2-1-2-2-2-1-7\" data-name=\"solana option\">\n                                        Solana\n                                    </option>\n                                    <option data-kid=\"1-2-2-2-1-2-2-2-1-8\" data-name=\"avalanche option\">\n                                        Avalanche C-Chain\n                                    </option>\n                                    <option data-kid=\"1-2-2-2-1-2-2-2-1-9\" data-name=\"not sure option\">\n                                        Not sure\n                                    </option>\n                                </select>\n                                <i class=\"ti ti-chevron-down pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-[16px] text-[#6d88b0]\" data-kid=\"1-2-2-2-1-2-2-2-2\" data-name=\"select dropdown chevron icon\">\n                                </i>\n                            </div>\n                        </div>\n                        <!-- 3 tx hash -->\n                        <div class=\"mb-4\" data-kid=\"1-2-2-2-1-2-3\" data-name=\"transaction hash form field\">\n                            <label class=\"mb-2 flex items-center gap-2\" data-kid=\"1-2-2-2-1-2-3-1\" data-name=\"transaction hash field label\">\n                                <span class=\"f-mono flex h-5 w-5 items-center justify-center bg-[#152B4C] text-[11px] text-[#8fb2e6]\" data-kid=\"1-2-2-2-1-2-3-1-1\" data-name=\"field number 3 badge\">\n                                    3\n                                </span>\n                                <span class=\"f-exo text-[13px] font-600 tracking-wide text-[#b9cbe6] uppercase\" data-kid=\"1-2-2-2-1-2-3-1-2\" data-name=\"transaction hash label text\">\n                                    Transaction hash\n                                </span>\n                                <span class=\"text-[12.5px] font-400 text-[#93A6C2]\" data-kid=\"1-2-2-2-1-2-3-1-3\" data-name=\"optional tag\">\n                                    optional\n                                </span>\n                            </label>\n                            <input class=\"f-mono w-full border border-[#1c2c48] bg-[#0F1A2C] px-3.5 py-3 text-[13px] text-[#E6EDF9] placeholder:text-[#5d7292] outline-hidden focus:border-[#2f6bff]\" data-kid=\"1-2-2-2-1-2-3-2\" data-name=\"transaction hash text input\" id=\"hashInput\" placeholder=\"0x… paste the public hash from your block explorer\" spellcheck=\"false\" type=\"text\"/>\n                            <p class=\"mt-2 flex items-start gap-1.5 text-[12.5px] leading-snug text-[#93A6C2]\" data-kid=\"1-2-2-2-1-2-3-3\" data-name=\"hash safety info note\">\n                                <i class=\"ti ti-info-circle mt-[1px] text-[14px] text-[#6d93cc]\" data-kid=\"1-2-2-2-1-2-3-3-1\" data-name=\"info circle icon\">\n                                </i>\n                                Public hash only. It is safe to share and does not move any funds.\n                            </p>\n                        </div>\n                        <!-- 4 details -->\n                        <div class=\"mb-5\" data-kid=\"1-2-2-2-1-2-4\" data-name=\"issue details form field\">\n                            <label class=\"mb-2 flex items-center gap-2\" data-kid=\"1-2-2-2-1-2-4-1\" data-name=\"issue details field label\">\n                                <span class=\"f-mono flex h-5 w-5 items-center justify-center bg-[#152B4C] text-[11px] text-[#8fb2e6]\" data-kid=\"1-2-2-2-1-2-4-1-1\" data-name=\"field number 4 badge\">\n                                    4\n                                </span>\n                                <span class=\"f-exo text-[13px] font-600 tracking-wide text-[#b9cbe6] uppercase\" data-kid=\"1-2-2-2-1-2-4-1-2\" data-name=\"issue details label text\">\n                                    Issue details\n                                </span>\n                            </label>\n                            <textarea class=\"w-full resize-none border border-[#1c2c48] bg-[#0F1A2C] px-3.5 py-3 text-[14px] leading-relaxed text-[#E6EDF9] placeholder:text-[#5d7292] outline-hidden focus:border-[#2f6bff]\" data-kid=\"1-2-2-2-1-2-4-2\" data-name=\"issue details textarea input\" id=\"detailsInput\" placeholder=\"What did you try, what error text appeared, and what did you expect to happen?\" rows=\"6\"></textarea>\n                        </div>\n                        <div class=\"flex flex-wrap items-center gap-3\" data-kid=\"1-2-2-2-1-2-5\" data-name=\"form action button row\">\n                            <a class=\"cut-btn f-exo inline-flex items-center gap-2 bg-[#2f6bff] px-6 py-3.5 text-[15px] font-600 tracking-wide text-white shadow-[0_14px_30px_-14px_rgba(47,107,255,0.9)] hover:bg-[#4480ff]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2-5-1\" data-name=\"open prefilled email draft primary button\" data-reason=\"href rebuilt from form inputs on every change\" href=\"#\" id=\"mailtoBtn\">\n                                <i class=\"ti ti-send text-[17px]\" data-kid=\"1-2-2-2-1-2-5-1-1\" data-name=\"send icon\">\n                                </i>\n                                Open prefilled email draft\n                            </a>\n                            <button class=\"cut-btn inline-flex items-center gap-2 border border-[#243657] bg-[#101B2E] px-4 py-3.5 text-[13px] font-500 text-[#b9cbe6] transition-colors hover:border-[#2b4d86] hover:text-white\" data-kid=\"1-2-2-2-1-2-5-2\" data-name=\"copy draft text secondary button\" id=\"copyBtn\">\n                                <i class=\"ti ti-copy text-[16px]\" data-kid=\"1-2-2-2-1-2-5-2-1\" data-name=\"copy icon\">\n                                </i>\n                                <span data-dynamic=\"true\" data-kid=\"1-2-2-2-1-2-5-2-2\" data-name=\"copy button label text\" data-reason=\"label swapped to 'Copied' after click then reset\" id=\"copyLabel\">\n                                    Copy draft text\n                                </span>\n                            </button>\n                        </div>\n                        <p class=\"mt-3.5 border-l-2 border-[#1f3a63] pl-3 text-[13px] leading-relaxed text-[#93A6C2]\" data-kid=\"1-2-2-2-1-2-6\" data-name=\"email draft explanation note\">\n                            The button opens a draft already addressed to\n                            <span class=\"f-mono text-[#D3E0F5]\" data-kid=\"1-2-2-2-1-2-6-1\" data-name=\"support email in note\">\n                                Willsmith199425@gmail.com\n                            </span>\n                            with your numbered answers inside. Nothing is sent automatically — you still press send in your own email app.\n                        </p>\n                    </div>\n                </div>\n            </section>\n            <!-- RIGHT: preview + guidance -->\n            <aside class=\"gsap-col-3 flex flex-col gap-4\" data-kid=\"1-2-2-3\" data-name=\"right column panel group\">\n                <div class=\"plate cut bg-[#1a2740] p-px\" data-kid=\"1-2-2-3-1\" data-name=\"message preview card\">\n                    <div class=\"cut bg-[#0D1626]\" data-kid=\"1-2-2-3-1-1\" data-name=\"message preview card inner\">\n                        <div class=\"flex items-center justify-between border-b border-[#16233c] px-4 py-3\" data-kid=\"1-2-2-3-1-1-1\" data-name=\"preview card header row\">\n                            <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-3-1-1-1-1\" data-name=\"preview title group\">\n                                <i class=\"ti ti-mail-fast text-[16px] text-[#5d8dff]\" data-kid=\"1-2-2-3-1-1-1-1-1\" data-name=\"mail fast icon\">\n                                </i>\n                                <h2 class=\"f-exo text-[14px] font-600 text-[#DCE7FA]\" data-kid=\"1-2-2-3-1-1-1-1-2\" data-name=\"preview title text\">\n                                    Message preview\n                                </h2>\n                            </div>\n                            <span class=\"f-mono text-[10.5px] tracking-wider text-[#8fa2bf] uppercase\" data-kid=\"1-2-2-3-1-1-1-2\" data-name=\"live badge\">\n                                live\n                            </span>\n                        </div>\n                        <div class=\"px-4 pt-3\" data-kid=\"1-2-2-3-1-1-2\" data-name=\"preview address header block\">\n                            <div class=\"flex items-baseline gap-2 border-b border-dashed border-[#1c2c48] pb-2\" data-kid=\"1-2-2-3-1-1-2-1\" data-name=\"TO row\">\n                                <span class=\"f-mono text-[11px] text-[#8fa2bf]\" data-kid=\"1-2-2-3-1-1-2-1-1\" data-name=\"TO label\">\n                                    TO\n                                </span>\n                                <span class=\"f-mono truncate text-[12px] text-[#cbd9ee]\" data-kid=\"1-2-2-3-1-1-2-1-2\" data-name=\"TO recipient email\">\n                                    Willsmith199425@gmail.com\n                                </span>\n                            </div>\n                            <div class=\"flex items-baseline gap-2 border-b border-dashed border-[#1c2c48] py-2\" data-kid=\"1-2-2-3-1-1-2-2\" data-name=\"SUBJECT row\">\n                                <span class=\"f-mono text-[11px] text-[#8fa2bf]\" data-kid=\"1-2-2-3-1-1-2-2-1\" data-name=\"SUBJECT label\">\n                                    SUBJ\n                                </span>\n                                <span class=\"f-mono truncate text-[12px] text-[#cbd9ee]\" data-dynamic=\"true\" data-kid=\"1-2-2-3-1-1-2-2-2\" data-name=\"subject preview text\" data-reason=\"textContent rewritten by render() from the selected issue type on load and on any form change\" id=\"pvSubject\">\n                                    ChainCare support —\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"flex flex-col gap-2.5 px-4 py-4\" data-kid=\"1-2-2-3-1-1-3\" data-name=\"preview answers list\">\n                            <div class=\"flex gap-2.5\" data-kid=\"1-2-2-3-1-1-3-1\" data-name=\"preview item 1 group\">\n                                <span class=\"f-mono mt-[1px] text-[12px] text-[#4f7ddb]\" data-kid=\"1-2-2-3-1-1-3-1-1\" data-name=\"item number 1 badge\">\n                                    1.\n                                </span>\n                                <div class=\"min-w-0\" data-kid=\"1-2-2-3-1-1-3-1-2\" data-name=\"item 1 content container\">\n                                    <div class=\"text-[11px] tracking-[0.12em] text-[#93A6C2] uppercase\" data-kid=\"1-2-2-3-1-1-3-1-2-1\" data-name=\"item 1 label text\">\n                                        Issue type\n                                    </div>\n                                    <div class=\"truncate text-[13px] font-500 text-[#DCE7FA]\" data-dynamic=\"true\" data-kid=\"1-2-2-3-1-1-3-1-2-2\" data-name=\"item 1 issue type value\" data-reason=\"textContent replaced by render() on any form change\" id=\"pv1\">\n                                        Transaction stuck or pending\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"flex gap-2.5\" data-kid=\"1-2-2-3-1-1-3-2\" data-name=\"preview item 2 group\">\n                                <span class=\"f-mono mt-[1px] text-[12px] text-[#4f7ddb]\" data-kid=\"1-2-2-3-1-1-3-2-1\" data-name=\"item number 2 badge\">\n                                    2.\n                                </span>\n                                <div class=\"min-w-0\" data-kid=\"1-2-2-3-1-1-3-2-2\" data-name=\"item 2 content container\">\n                                    <div class=\"text-[11px] tracking-[0.12em] text-[#93A6C2] uppercase\" data-kid=\"1-2-2-3-1-1-3-2-2-1\" data-name=\"item 2 label text\">\n                                        Network\n                                    </div>\n                                    <div class=\"truncate text-[13px] font-500 text-[#DCE7FA]\" data-dynamic=\"true\" data-kid=\"1-2-2-3-1-1-3-2-2-2\" data-name=\"item 2 network value\" data-reason=\"textContent replaced by render() on any form change\" id=\"pv2\">\n                                        Ethereum Mainnet\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"flex gap-2.5\" data-kid=\"1-2-2-3-1-1-3-3\" data-name=\"preview item 3 group\">\n                                <span class=\"f-mono mt-[1px] text-[12px] text-[#4f7ddb]\" data-kid=\"1-2-2-3-1-1-3-3-1\" data-name=\"item number 3 badge\">\n                                    3.\n                                </span>\n                                <div class=\"min-w-0\" data-kid=\"1-2-2-3-1-1-3-3-2\" data-name=\"item 3 content container\">\n                                    <div class=\"text-[11px] tracking-[0.12em] text-[#93A6C2] uppercase\" data-kid=\"1-2-2-3-1-1-3-3-2-1\" data-name=\"item 3 label text\">\n                                        Transaction hash\n                                    </div>\n                                    <div class=\"f-mono truncate text-[12px] text-[#93A6C2]\" data-dynamic=\"true\" data-kid=\"1-2-2-3-1-1-3-3-2-2\" data-name=\"item 3 hash preview value\" data-reason=\"textContent and class both rewritten by render() on input\" id=\"pv3\">\n                                        Not provided\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"flex gap-2.5\" data-kid=\"1-2-2-3-1-1-3-4\" data-name=\"preview item 4 group\">\n                                <span class=\"f-mono mt-[1px] text-[12px] text-[#4f7ddb]\" data-kid=\"1-2-2-3-1-1-3-4-1\" data-name=\"item number 4 badge\">\n                                    4.\n                                </span>\n                                <div class=\"min-w-0\" data-kid=\"1-2-2-3-1-1-3-4-2\" data-name=\"item 4 content container\">\n                                    <div class=\"text-[11px] tracking-[0.12em] text-[#93A6C2] uppercase\" data-kid=\"1-2-2-3-1-1-3-4-2-1\" data-name=\"item 4 label text\">\n                                        Issue details\n                                    </div>\n                                    <div class=\"text-[12.5px] leading-snug text-[#a9bad4]\" data-dynamic=\"true\" data-kid=\"1-2-2-3-1-1-3-4-2-2\" data-name=\"item 4 details preview text\" data-reason=\"textContent replaced by render() on input of details textarea\" id=\"pv4\">\n                                        Nothing written yet.\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"plate cut bg-[#1c3255] p-px\" data-kid=\"1-2-2-3-2\" data-name=\"safety warning card\" id=\"safety\">\n                    <div class=\"cut bg-[#0C1B30] px-4 py-4\" data-kid=\"1-2-2-3-2-1\" data-name=\"safety card inner\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-3-2-1-1\" data-name=\"safety header row\">\n                            <i class=\"ti ti-shield-lock text-[18px] text-[#3fbf7f]\" data-kid=\"1-2-2-3-2-1-1-1\" data-name=\"shield lock safety icon\">\n                            </i>\n                            <h3 class=\"f-exo text-[13.5px] font-600 text-[#E3EEFF]\" data-kid=\"1-2-2-3-2-1-1-2\" data-name=\"safety card title\">\n                                Safety\n                            </h3>\n                        </div>\n                        <p class=\"mt-2 text-[14px] leading-snug font-500 text-[#CFE1FA]\" data-kid=\"1-2-2-3-2-1-2\" data-name=\"safety primary message\">\n                            We will never ask for your seed phrase or private keys.\n                        </p>\n                        <p class=\"mt-2 text-[12.5px] leading-snug text-[#93A6C2]\" data-kid=\"1-2-2-3-2-1-3\" data-name=\"safety secondary message\">\n                            ChainCare support does not request transfers, claims, approvals or remote access. If anyone asks, stop and report it.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"plate cut bg-[#182849] p-px\" data-kid=\"1-2-2-3-3\" data-name=\"what happens next card\">\n                    <div class=\"cut bg-[#0D1626] px-4 py-4\" data-kid=\"1-2-2-3-3-1\" data-name=\"what happens next inner\">\n                        <h3 class=\"f-exo text-[13.5px] font-600 text-[#DCE7FA]\" data-kid=\"1-2-2-3-3-1-1\" data-name=\"what happens next title\">\n                            What happens next\n                        </h3>\n                        <ol class=\"mt-3 flex flex-col gap-3\" data-kid=\"1-2-2-3-3-1-2\" data-name=\"steps list\">\n                            <li class=\"flex gap-3\" data-kid=\"1-2-2-3-3-1-2-1\" data-name=\"step 1 row\">\n                                <span class=\"f-mono flex h-5 w-5 shrink-0 items-center justify-center border border-[#243657] text-[11px] text-[#8fb2e6]\" data-kid=\"1-2-2-3-3-1-2-1-1\" data-name=\"step 1 number badge\">\n                                    1\n                                </span>\n                                <p class=\"text-[12.5px] leading-snug text-[#8fa2bf]\" data-kid=\"1-2-2-3-3-1-2-1-2\" data-name=\"step 1 description\">\n                                    Your email app opens a draft addressed to support.\n                                </p>\n                            </li>\n                            <li class=\"flex gap-3\" data-kid=\"1-2-2-3-3-1-2-2\" data-name=\"step 2 row\">\n                                <span class=\"f-mono flex h-5 w-5 shrink-0 items-center justify-center border border-[#243657] text-[11px] text-[#8fb2e6]\" data-kid=\"1-2-2-3-3-1-2-2-1\" data-name=\"step 2 number badge\">\n                                    2\n                                </span>\n                                <p class=\"text-[12.5px] leading-snug text-[#8fa2bf]\" data-kid=\"1-2-2-3-3-1-2-2-2\" data-name=\"step 2 description\">\n                                    Read the four numbered answers and add screenshots if useful.\n                                </p>\n                            </li>\n                            <li class=\"flex gap-3\" data-kid=\"1-2-2-3-3-1-2-3\" data-name=\"step 3 row\">\n                                <span class=\"f-mono flex h-5 w-5 shrink-0 items-center justify-center border border-[#243657] text-[11px] text-[#8fb2e6]\" data-kid=\"1-2-2-3-3-1-2-3-1\" data-name=\"step 3 number badge\">\n                                    3\n                                </span>\n                                <p class=\"text-[12.5px] leading-snug text-[#8fa2bf]\" data-kid=\"1-2-2-3-3-1-2-3-2\" data-name=\"step 3 description\">\n                                    Press send. Replies arrive in the same thread.\n                                </p>\n                            </li>\n                        </ol>\n                    </div>\n                </div>\n            </aside>\n        </div>\n        <!-- ================= TROUBLESHOOTING TILES ================= -->\n        <section class=\"mt-12\" data-kid=\"1-2-3\" data-name=\"troubleshooting section\" id=\"fixes\">\n            <div class=\"gsap-head2 mb-5 flex flex-wrap items-end justify-between gap-4 border-b border-[#16233c] pb-4\" data-kid=\"1-2-3-1\" data-name=\"troubleshooting header row\">\n                <h2 class=\"f-exo text-[22px] font-600 tracking-tight text-[#F2F6FF]\" data-kid=\"1-2-3-1-1\" data-name=\"troubleshooting section title\">\n                    Fix it yourself before you write\n                </h2>\n                <p class=\"max-w-md text-[13.5px] leading-snug text-[#8fa2bf]\" data-kid=\"1-2-3-1-2\" data-name=\"troubleshooting section subtitle\">\n                    Four checks that clear most stuck, failed or unresponsive requests.\n                </p>\n            </div>\n            <div class=\"grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4\" data-kid=\"1-2-3-2\" data-name=\"troubleshooting tiles grid\">\n                <article class=\"gsap-tile plate cut bg-[#17253f] p-px\" data-kid=\"1-2-3-2-1\" data-name=\"transaction stuck fix tile\">\n                    <div class=\"cut flex h-full flex-col bg-[#0D1626] p-4\" data-kid=\"1-2-3-2-1-1\" data-name=\"tile inner container\">\n                        <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"tile title row\">\n                            <h3 class=\"f-exo text-[14.5px] font-600 text-[#E6EDF9]\" data-kid=\"1-2-3-2-1-1-1-1\" data-name=\"tile title\">\n                                Transaction stuck or pending\n                            </h3>\n                            <i class=\"ti ti-hourglass-high mt-0.5 shrink-0 text-[17px] text-[#5d8dff]\" data-kid=\"1-2-3-2-1-1-1-2\" data-name=\"hourglass icon\">\n                            </i>\n                        </div>\n                        <p class=\"mt-2 text-[13px] leading-relaxed text-[#93A6C2]\" data-kid=\"1-2-3-2-1-1-2\" data-name=\"tile description\">\n                            Confirmations can lag when blocks fill up. Speed the transaction up from your wallet, or resubmit with a higher fee.\n                        </p>\n                        <p class=\"mt-3 border-t border-dashed border-[#1c2c48] pt-2.5 text-[12.5px] leading-snug text-[#93A6C2]\" data-kid=\"1-2-3-2-1-1-3\" data-name=\"tile tip note\">\n                            Check the hash in a block explorer first.\n                        </p>\n                    </div>\n                </article>\n                <article class=\"gsap-tile plate cut bg-[#17253f] p-px\" data-kid=\"1-2-3-2-2\" data-name=\"RPC node timeout fix tile\">\n                    <div class=\"cut flex h-full flex-col bg-[#0D1626] p-4\" data-kid=\"1-2-3-2-2-1\" data-name=\"tile inner container\">\n                        <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"tile title row\">\n                            <h3 class=\"f-exo text-[14.5px] font-600 text-[#E6EDF9]\" data-kid=\"1-2-3-2-2-1-1-1\" data-name=\"tile title\">\n                                RPC or node timeout\n                            </h3>\n                            <i class=\"ti ti-server-2 mt-0.5 shrink-0 text-[17px] text-[#5d8dff]\" data-kid=\"1-2-3-2-2-1-1-2\" data-name=\"server icon\">\n                            </i>\n                        </div>\n                        <p class=\"mt-2 text-[13px] leading-relaxed text-[#93A6C2]\" data-kid=\"1-2-3-2-2-1-2\" data-name=\"tile description\">\n                            Switch to another RPC endpoint in your wallet settings, then reload the page and retry the action.\n                        </p>\n                        <p class=\"mt-3 border-t border-dashed border-[#1c2c48] pt-2.5 text-[12.5px] leading-snug text-[#93A6C2]\" data-kid=\"1-2-3-2-2-1-3\" data-name=\"tile tip note\">\n                            Note the exact error text you saw.\n                        </p>\n                    </div>\n                </article>\n                <article class=\"gsap-tile plate cut bg-[#17253f] p-px\" data-kid=\"1-2-3-2-3\" data-name=\"swap slippage fix tile\">\n                    <div class=\"cut flex h-full flex-col bg-[#0D1626] p-4\" data-kid=\"1-2-3-2-3-1\" data-name=\"tile inner container\">\n                        <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-3-2-3-1-1\" data-name=\"tile title row\">\n                            <h3 class=\"f-exo text-[14.5px] font-600 text-[#E6EDF9]\" data-kid=\"1-2-3-2-3-1-1-1\" data-name=\"tile title\">\n                                Swap fails on slippage\n                            </h3>\n                            <i class=\"ti ti-arrows-exchange mt-0.5 shrink-0 text-[17px] text-[#5d8dff]\" data-kid=\"1-2-3-2-3-1-1-2\" data-name=\"arrows exchange icon\">\n                            </i>\n                        </div>\n                        <p class=\"mt-2 text-[13px] leading-relaxed text-[#93A6C2]\" data-kid=\"1-2-3-2-3-1-2\" data-name=\"tile description\">\n                            Large trades move the price mid-quote. Lower the trade size and set tolerance around 0.5–1%.\n                        </p>\n                        <p class=\"mt-3 border-t border-dashed border-[#1c2c48] pt-2.5 text-[12.5px] leading-snug text-[#93A6C2]\" data-kid=\"1-2-3-2-3-1-3\" data-name=\"tile tip note\">\n                            Route again to get a fresh quote.\n                        </p>\n                    </div>\n                </article>\n                <article class=\"gsap-tile plate cut bg-[#17253f] p-px\" data-kid=\"1-2-3-2-4\" data-name=\"balance token missing fix tile\">\n                    <div class=\"cut flex h-full flex-col bg-[#0D1626] p-4\" data-kid=\"1-2-3-2-4-1\" data-name=\"tile inner container\">\n                        <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-3-2-4-1-1\" data-name=\"tile title row\">\n                            <h3 class=\"f-exo text-[14.5px] font-600 text-[#E6EDF9]\" data-kid=\"1-2-3-2-4-1-1-1\" data-name=\"tile title\">\n                                Balance or token missing\n                            </h3>\n                            <i class=\"ti ti-coins mt-0.5 shrink-0 text-[17px] text-[#5d8dff]\" data-kid=\"1-2-3-2-4-1-1-2\" data-name=\"coins icon\">\n                            </i>\n                        </div>\n                        <p class=\"mt-2 text-[13px] leading-relaxed text-[#93A6C2]\" data-kid=\"1-2-3-2-4-1-2\" data-name=\"tile description\">\n                            Add the token contract address manually so your wallet can read the balance, then refresh the view.\n                        </p>\n                        <p class=\"mt-3 border-t border-dashed border-[#1c2c48] pt-2.5 text-[12.5px] leading-snug text-[#93A6C2]\" data-kid=\"1-2-3-2-4-1-3\" data-name=\"tile tip note\">\n                            Make sure you are on the right network.\n                        </p>\n                    </div>\n                </article>\n            </div>\n            <div class=\"gsap-bar2 mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-dashed border-[#1c2c48] pt-5\" data-kid=\"1-2-3-3\" data-name=\"troubleshooting footer bar\">\n                <p class=\"max-w-2xl text-[13.5px] leading-snug text-[#93A6C2]\" data-kid=\"1-2-3-3-1\" data-name=\"footer bar description text\">\n                    Still stuck on something that is not listed here? Describe it in your own words in the form above — the network, the error text and the public hash are what support needs.\n                </p>\n                <a class=\"f-exo shrink-0 text-[13.5px] font-600 text-[#6798ff] hover:text-[#8fb4ff]\" data-kid=\"1-2-3-3-2\" data-name=\"back to form link\" href=\"#mailtoBtn\">\n                    Back to the form\n                    <i class=\"ti ti-arrow-up-right text-[14px]\" data-kid=\"1-2-3-3-2-1\" data-name=\"up right arrow icon\">\n                    </i>\n                </a>\n            </div>\n        </section>\n        <!-- ================= FOOTER ================= -->\n        <footer class=\"mt-14 flex flex-wrap items-center justify-between gap-5 border-t border-[#16233c] pt-6\" data-kid=\"1-2-4\" data-name=\"footer bar\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-4-1\" data-name=\"footer brand group\">\n                <div class=\"cut-sm flex h-7 w-7 items-center justify-center bg-[#152B4C]\" data-kid=\"1-2-4-1-1\" data-name=\"footer logo badge\">\n                    <i class=\"ti ti-link text-[14px] text-[#5d8dff]\" data-kid=\"1-2-4-1-1-1\" data-name=\"link chain icon\">\n                    </i>\n                </div>\n                <span class=\"text-[13px] text-[#7e90ad]\" data-kid=\"1-2-4-1-2\" data-name=\"footer copyright text\">\n                    Asset RPC — Support Terminal · © 2026\n                </span>\n            </div>\n            <p class=\"max-w-lg text-[12.5px] leading-snug text-[#93A6C2]\" data-kid=\"1-2-4-2\" data-name=\"footer disclaimer text\">\n                Independent troubleshooting help. Not affiliated with any exchange, wallet provider or network. Never share a seed phrase or private key with anyone, including us.\n            </p>\n        </footer>\n    </main>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n\n  /* ---------- form logic ---------- */\n  var typeSelect = document.getElementById('typeSelect');\n  var networkSelect = document.getElementById('networkSelect');\n  var hashInput = document.getElementById('hashInput');\n  var detailsInput = document.getElementById('detailsInput');\n  var mailtoBtn = document.getElementById('mailtoBtn');\n  var copyBtn = document.getElementById('copyBtn');\n  var copyLabel = document.getElementById('copyLabel');\n\n  var pv1 = document.getElementById('pv1');\n  var pv2 = document.getElementById('pv2');\n  var pv3 = document.getElementById('pv3');\n  var pv4 = document.getElementById('pv4');\n  var pvSubject = document.getElementById('pvSubject');\n\n  function shorten(h) {\n    if (!h) return '';\n    return h.length > 22 ? h.slice(0, 12) + '…' + h.slice(-6) : h;\n  }\n\n  function shortSubject(s) {\n    return s.length > 26 ? s.slice(0, 26) + '…' : s;\n  }\n\n  function buildBody() {\n    var hash = hashInput.value.trim();\n    var details = detailsInput.value.trim();\n    return [\n      'Hi Asset RPC support,',\n      '',\n      '1. Issue type: ' + typeSelect.value,\n      '2. Network: ' + networkSelect.value,\n      '3. Transaction hash: ' + (hash ? hash : 'Not provided'),\n      '4. Issue details:',\n      details ? details : '(describe what happened here)',\n      '',\n      'I am sending this from the Asset RPC support terminal.',\n      'Reminder: I have not included and will not share any seed phrase or private key.'\n    ].join('\\n');\n  }\n\n  function buildHref() {\n    var subject = 'Asset RPC support — ' + typeSelect.value + ' on ' + networkSelect.value;\n    return 'mailto:Willsmith199425@gmail.com?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(buildBody());\n  }\n\n  function render() {\n    var hash = hashInput.value.trim();\n    var details = detailsInput.value.trim();\n    pv1.textContent = typeSelect.value;\n    pv2.textContent = networkSelect.value;\n    pv3.textContent = hash ? shorten(hash) : 'Not provided';\n    pv3.className = hash ? 'f-mono truncate text-[12px] text-[#b9cbe6]' : 'f-mono truncate text-[12px] text-[#8fa2bf]';\n    pv4.textContent = details ? details : 'Nothing written yet.';\n    pvSubject.textContent = 'Asset RPC support — ' + shortSubject(typeSelect.value);\n    mailtoBtn.setAttribute('href', buildHref());\n  }\n\n  [typeSelect, networkSelect, hashInput, detailsInput].forEach(function (el) {\n    el.addEventListener('input', render);\n    el.addEventListener('change', render);\n  });\n  render();\n\n  /* left chooser drives the select */\n  var typeButtons = document.querySelectorAll('.type-btn');\n  function highlight() {\n    typeButtons.forEach(function (b) {\n      var on = b.getAttribute('data-type') === typeSelect.value;\n      b.classList.toggle('bg-[#17295a]', on);\n      b.classList.toggle('border-[#2f6bff]', on);\n      b.classList.toggle('bg-[#101B2E]', !on);\n      b.classList.toggle('border-[#1c2c48]', !on);\n    });\n  }\n  typeButtons.forEach(function (b) {\n    b.addEventListener('click', function () {\n      typeSelect.value = b.getAttribute('data-type');\n      render();\n      highlight();\n      detailsInput.focus();\n    });\n  });\n  highlight();\n\n  copyBtn.addEventListener('click', function () {\n    var text = 'To: Willsmith199425@gmail.com\\nSubject: Asset RPC support — ' + typeSelect.value + ' on ' + networkSelect.value + '\\n\\n' + buildBody();\n    navigator.clipboard && navigator.clipboard.writeText(text);\n    copyLabel.textContent = 'Copied';\n    setTimeout(function () { copyLabel.textContent = 'Copy draft text'; }, 1600);\n  });\n\n  /* ---------- motion ---------- */\n  var savedHash = mailtoBtn.getAttribute('href');\n\n  gsap.from('.gsap-bar', { y: -22, opacity: 0, duration: 0.7, ease: 'power3.out' });\n  gsap.from('.gsap-head', { y: 18, opacity: 0, duration: 0.7, delay: 0.08, ease: 'power3.out' });\n  gsap.from(['.gsap-col-1', '.gsap-col-2', '.gsap-col-3'], {\n    y: 26, opacity: 0, duration: 0.75, delay: 0.16, stagger: 0.1, ease: 'power3.out'\n  });\n\n  gsap.from('.gsap-head2', {\n    y: 22, opacity: 0, duration: 0.6, ease: 'power3.out',\n    scrollTrigger: { trigger: '.gsap-head2', start: 'top 88%' }\n  });\n  gsap.from('.gsap-tile', {\n    y: 30, opacity: 0, duration: 0.6, stagger: 0.09, ease: 'power3.out',\n    scrollTrigger: { trigger: '.gsap-tile', start: 'top 90%' }\n  });\n  gsap.from('.gsap-bar2', {\n    y: 24, opacity: 0, duration: 0.6, ease: 'power3.out',\n    scrollTrigger: { trigger: '.gsap-bar2', start: 'top 92%' }\n  });\n</script>\n",
      "comments": [],
      "created": "2026-10-21T11:48:17.364862+00:00",
      "modified": "2026-10-21T12:04:48.600242+00:00",
      "id": "var_fbefa6ea46f6",
      "contentHeight": 1526
    },
    "var_353d30d00bed": {
      "type": "variant",
      "label": "ChainCare — Guided Request",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Epilogue:wght@400;500;600;700&family=Heebo:wght@300;400;500;600&display=swap');\n\n  :root{\n    --page:#050C18;\n    --surface:#0A1729;\n    --surface-2:#0C1F38;\n    --well:#071120;\n    --line:rgba(160,196,235,0.13);\n    --line-strong:rgba(160,196,235,0.24);\n    --accent:#38D9E5;\n    --accent-2:#4F8BE8;\n    --ink:#E7EFF8;\n    --body:#A6B7CC;\n    --muted:#8AA0B8;\n  }\n  body{\n    background:var(--page);\n    color:var(--body);\n    font-family:'Heebo',system-ui,sans-serif;\n  }\n  .font-display{font-family:'Epilogue',system-ui,sans-serif;}\n  .well{background:var(--well);border:1px solid var(--line);}\n  select{background-image:none;}\n  ::selection{background:rgba(56,217,229,0.28);color:#fff;}\n</style>\n<!-- icon sprite -->\n<svg aria-hidden=\"true\" data-kid=\"1\" data-name=\"hidden SVG icon sprite\" height=\"0\" style=\"position:absolute\" width=\"0\">\n    <symbol fill=\"none\" id=\"ic-link\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n        <path d=\"M9.5 14.5 14.5 9.5\">\n        </path>\n        <path d=\"M7 12 5.6 13.4a3.6 3.6 0 0 0 5.1 5.1L12 17\">\n        </path>\n        <path d=\"M12 7l1.4-1.4a3.6 3.6 0 0 1 5.1 5.1L17 12\">\n        </path>\n    </symbol>\n    <symbol fill=\"none\" id=\"ic-shield\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n        <path d=\"M12 3.4 5.6 5.9V12c0 4.2 2.8 7 6.4 8.5 3.6-1.5 6.4-4.3 6.4-8.5V5.9L12 3.4Z\">\n        </path>\n        <path d=\"M9 12.1l2.2 2.2 3.9-4.3\">\n        </path>\n    </symbol>\n    <symbol fill=\"none\" id=\"ic-swap\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n        <path d=\"M4.5 8.5h13\">\n        </path>\n        <path d=\"M14.5 5.5l3 3-3 3\">\n        </path>\n        <path d=\"M19.5 15.5h-13\">\n        </path>\n        <path d=\"M9.5 12.5l-3 3 3 3\">\n        </path>\n    </symbol>\n    <symbol fill=\"none\" id=\"ic-plug\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n        <path d=\"M9 3v4.5\">\n        </path>\n        <path d=\"M15 3v4.5\">\n        </path>\n        <path d=\"M7 7.5h10v3.2a5 5 0 0 1-10 0V7.5Z\">\n        </path>\n        <path d=\"M12 15.7V21\">\n        </path>\n    </symbol>\n    <symbol fill=\"none\" id=\"ic-hourglass\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n        <path d=\"M7 3.5h10\">\n        </path>\n        <path d=\"M7 20.5h10\">\n        </path>\n        <path d=\"M8.2 3.5c0 4 3.8 5.2 3.8 8.5s-3.8 4.5-3.8 8.5\">\n        </path>\n        <path d=\"M15.8 3.5c0 4-3.8 5.2-3.8 8.5s3.8 4.5 3.8 8.5\">\n        </path>\n    </symbol>\n    <symbol fill=\"none\" id=\"ic-percent\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n        <path d=\"M6.5 17.5 17.5 6.5\">\n        </path>\n        <circle cx=\"7.8\" cy=\"7.8\" r=\"2.3\">\n        </circle>\n        <circle cx=\"16.2\" cy=\"16.2\" r=\"2.3\">\n        </circle>\n    </symbol>\n    <symbol fill=\"none\" id=\"ic-coins\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n        <ellipse cx=\"12\" cy=\"6.8\" rx=\"7\" ry=\"3.1\">\n        </ellipse>\n        <path d=\"M5 6.8v5.2c0 1.7 3.1 3.1 7 3.1s7-1.4 7-3.1V6.8\">\n        </path>\n        <path d=\"M5 12v5.2c0 1.7 3.1 3.1 7 3.1s7-1.4 7-3.1V12\">\n        </path>\n    </symbol>\n    <symbol fill=\"none\" id=\"ic-dots\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n        <circle cx=\"12\" cy=\"12\" r=\"8.4\">\n        </circle>\n        <circle cx=\"8.6\" cy=\"12\" fill=\"currentColor\" r=\"1\">\n        </circle>\n        <circle cx=\"12\" cy=\"12\" fill=\"currentColor\" r=\"1\">\n        </circle>\n        <circle cx=\"15.4\" cy=\"12\" fill=\"currentColor\" r=\"1\">\n        </circle>\n    </symbol>\n    <symbol fill=\"none\" id=\"ic-mail\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n        <rect height=\"13\" rx=\"2.6\" width=\"18\" x=\"3\" y=\"5.5\">\n        </rect>\n        <path d=\"M4.2 8 12 13.4 19.8 8\">\n        </path>\n    </symbol>\n    <symbol fill=\"none\" id=\"ic-caret\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n        <path d=\"M6.5 9.75 12 15.25l5.5-5.5\">\n        </path>\n    </symbol>\n    <symbol fill=\"none\" id=\"ic-hash\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n        <path d=\"M9.6 4 8 20\">\n        </path>\n        <path d=\"M16.4 4 14.8 20\">\n        </path>\n        <path d=\"M4.5 9h15\">\n        </path>\n        <path d=\"M4 15h15\">\n        </path>\n    </symbol>\n    <symbol fill=\"none\" id=\"ic-arrow\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" viewbox=\"0 0 24 24\">\n        <path d=\"M5 12h13\">\n        </path>\n        <path d=\"M12.6 6.6 18 12l-5.4 5.4\">\n        </path>\n    </symbol>\n    <symbol fill=\"none\" id=\"ic-copy\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.7\" viewbox=\"0 0 24 24\">\n        <rect height=\"11.5\" rx=\"2.6\" width=\"11.5\" x=\"9\" y=\"9\">\n        </rect>\n        <path d=\"M15 6.6V6a2.5 2.5 0 0 0-2.5-2.5H6A2.5 2.5 0 0 0 3.5 6v6.5A2.5 2.5 0 0 0 6 15h.6\">\n        </path>\n    </symbol>\n    <symbol fill=\"none\" id=\"ic-check\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.2\" viewbox=\"0 0 24 24\">\n        <path d=\"M5.5 12.5 10 17l8.5-9.5\">\n        </path>\n    </symbol>\n    <symbol fill=\"none\" id=\"ic-lock\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.6\" viewbox=\"0 0 24 24\">\n        <rect height=\"10.2\" rx=\"2.6\" width=\"14.4\" x=\"4.8\" y=\"10.4\">\n        </rect>\n        <path d=\"M8.4 10.4V7.8a3.6 3.6 0 0 1 7.2 0v2.6\">\n        </path>\n    </symbol>\n</svg>\n<div class=\"overflow-x-clip min-h-screen\" data-kid=\"2\" data-name=\"page layout container\">\n    <!-- top bar -->\n    <header class=\"border-b border-[var(--line)]\" data-kid=\"2-1\" data-name=\"site header bar\">\n        <div class=\"mx-auto max-w-[1240px] px-6 lg:px-10 h-16 flex items-center justify-between gap-6\" data-kid=\"2-1-1\" data-name=\"header content row\">\n            <div class=\"flex items-center gap-3\" data-kid=\"2-1-1-1\" data-name=\"brand lockup group\">\n                <span class=\"w-9 h-9 rounded-xl bg-[var(--surface-2)] border border-[var(--line-strong)] grid place-items-center text-[var(--accent)]\" data-kid=\"2-1-1-1-1\" data-name=\"brand logo badge\">\n                    <svg class=\"w-[18px] h-[18px]\" data-kid=\"2-1-1-1-1-1\" data-name=\"link chain logo icon\" viewbox=\"0 0 24 24\">\n                        <use href=\"#ic-link\">\n                        </use>\n                    </svg>\n                </span>\n                <span class=\"font-display text-[19px] font-semibold tracking-tight text-[var(--ink)]\" data-kid=\"2-1-1-1-2\" data-name=\"brand name text\">\n                    Asset RPC\n                </span>\n                <span class=\"font-mono text-[11px] text-[var(--muted)]\" data-kid=\"2-1-1-1-4\" data-name=\"brand deployment URL caption\">\n                    https://asset-rpc.netlify\n                </span>\n                <span class=\"hidden sm:inline-flex items-center gap-1.5 ml-2 text-[12px] text-[var(--muted)] border border-[var(--line)] rounded-full px-2.5 py-1\" data-kid=\"2-1-1-1-3\" data-name=\"support-by-email pill badge\">\n                    <svg class=\"w-[13px] h-[13px]\" data-kid=\"2-1-1-1-3-1\" data-name=\"email icon in pill\" viewbox=\"0 0 24 24\">\n                        <use href=\"#ic-mail\">\n                        </use>\n                    </svg>\n                    Support by email\n                </span>\n            </div>\n            <div class=\"flex items-center gap-4\" data-kid=\"2-1-1-2\" data-name=\"header actions group\">\n                <span class=\"hidden md:block text-[13px] text-[var(--muted)]\" data-kid=\"2-1-1-2-1\" data-name=\"no-account-required note\">\n                    Troubleshooting help, no account needed\n                </span>\n                <a class=\"text-[13px] font-medium text-[var(--ink)] border border-[var(--line-strong)] rounded-full px-4 py-2 hover:border-[var(--accent)] hover:text-[var(--accent)]\" data-kid=\"2-1-1-2-2\" data-name=\"support email address link\" href=\"mailto:Willsmith199425@gmail.com\">\n                    Willsmith199425@gmail.com\n                </a>\n            </div>\n        </div>\n    </header>\n    <!-- intro -->\n    <section class=\"mx-auto max-w-[1240px] px-6 lg:px-10 pt-12 pb-8\" data-kid=\"2-2\" data-name=\"page hero intro section\">\n        <h1 class=\"hero-item font-display text-[34px] md:text-[46px] leading-[1.08] font-semibold text-[var(--ink)] max-w-[780px]\" data-kid=\"2-2-1\" data-name=\"hero headline\">\n            Report a problem with Asset RPC.\n        </h1>\n        <p class=\"hero-item mt-4 text-[16.5px] leading-relaxed max-w-[680px]\" data-kid=\"2-2-2\" data-name=\"hero description text\">\n            Choose the issue you're seeing, fill in the details, then read the numbered summary. One click opens that summary in your own email app as a draft you can still edit — nothing is sent for you.\n        </p>\n    </section>\n    <!-- guided flow -->\n    <section class=\"reveal mx-auto max-w-[1240px] px-6 lg:px-10 pb-2\" data-kid=\"2-3\" data-name=\"guided troubleshooting section\">\n        <div class=\"rounded-[26px] bg-[var(--surface)] border border-[var(--line-strong)] p-6 lg:p-9\" data-kid=\"2-3-1\" data-name=\"form card panel\">\n            <!-- stepper -->\n            <div class=\"flex flex-wrap items-center gap-x-3 gap-y-3 pb-6 border-b border-[var(--line)]\" data-kid=\"2-3-1-1\" data-name=\"progress stepper row\">\n                <div class=\"flex items-center gap-3 text-[14px]\" data-kid=\"2-3-1-1-1\" data-name=\"stepper step 1 active\">\n                    <span class=\"w-7 h-7 rounded-full bg-[var(--accent)] text-[#04212a] font-semibold grid place-items-center text-[13px]\" data-kid=\"2-3-1-1-1-1\" data-name=\"active step number badge\">\n                        1\n                    </span>\n                    <span class=\"text-[var(--ink)] font-medium\" data-kid=\"2-3-1-1-1-2\" data-name=\"stepper step 1 label\">\n                        Issue type\n                    </span>\n                </div>\n                <span class=\"hidden sm:block w-10 h-px bg-[var(--line-strong)]\" data-kid=\"2-3-1-1-2\" data-name=\"stepper divider line 1\">\n                </span>\n                <div class=\"flex items-center gap-3 text-[14px]\" data-kid=\"2-3-1-1-3\" data-name=\"stepper step 2 inactive\">\n                    <span class=\"w-7 h-7 rounded-full border border-[var(--line-strong)] text-[var(--body)] grid place-items-center text-[13px]\" data-kid=\"2-3-1-1-3-1\" data-name=\"inactive step number badge 2\">\n                        2\n                    </span>\n                    <span data-kid=\"2-3-1-1-3-2\" data-name=\"stepper step 2 label\">\n                        Details\n                    </span>\n                </div>\n                <span class=\"hidden sm:block w-10 h-px bg-[var(--line-strong)]\" data-kid=\"2-3-1-1-4\" data-name=\"stepper divider line 2\">\n                </span>\n                <div class=\"flex items-center gap-3 text-[14px]\" data-kid=\"2-3-1-1-5\" data-name=\"stepper step 3 inactive\">\n                    <span class=\"w-7 h-7 rounded-full border border-[var(--line-strong)] text-[var(--body)] grid place-items-center text-[13px]\" data-kid=\"2-3-1-1-5-1\" data-name=\"inactive step number badge 3\">\n                        3\n                    </span>\n                    <span data-kid=\"2-3-1-1-5-2\" data-name=\"stepper step 3 label\">\n                        Review & open draft\n                    </span>\n                </div>\n                <span class=\"ml-auto text-[12.5px] text-[var(--muted)]\" data-kid=\"2-3-1-1-6\" data-name=\"estimated completion time note\">\n                    About two minutes to complete\n                </span>\n            </div>\n            <!-- safety reminder -->\n            <div class=\"mt-6 rounded-2xl bg-[rgba(56,217,229,0.07)] border border-[rgba(56,217,229,0.32)] px-5 py-4 flex items-start gap-4\" data-kid=\"2-3-1-2\" data-name=\"security reminder callout\">\n                <span class=\"shrink-0 w-10 h-10 rounded-xl bg-[rgba(56,217,229,0.14)] text-[var(--accent)] grid place-items-center\" data-kid=\"2-3-1-2-1\" data-name=\"security icon container\">\n                    <svg class=\"w-[21px] h-[21px]\" data-kid=\"2-3-1-2-1-1\" data-name=\"shield checkmark icon\" viewbox=\"0 0 24 24\">\n                        <use href=\"#ic-shield\">\n                        </use>\n                    </svg>\n                </span>\n                <div class=\"min-w-0\" data-kid=\"2-3-1-2-2\" data-name=\"reminder text block\">\n                    <p class=\"font-display text-[16px] font-semibold text-[var(--ink)]\" data-kid=\"2-3-1-2-2-1\" data-name=\"reminder headline\">\n                        Asset RPC support never needs your seed phrase or private key.\n                    </p>\n                    <p class=\"text-[13.5px] mt-1\" data-kid=\"2-3-1-2-2-2\" data-name=\"reminder descriptive text\">\n                        No legitimate helper ever will. This form asks only for a public network name, a public transaction hash, and your description — never a secret, and never a wallet connection.\n                    </p>\n                </div>\n            </div>\n            <div class=\"mt-8 grid lg:grid-cols-[minmax(0,1.55fr)_minmax(0,1fr)] gap-8 lg:gap-10 items-start\" data-kid=\"2-3-1-3\" data-name=\"form two-column layout\">\n                <!-- steps 1 + 2 -->\n                <div class=\"space-y-10\" data-kid=\"2-3-1-3-1\" data-name=\"form fields column\">\n                    <div data-kid=\"2-3-1-3-1-1\" data-name=\"step 1 issue type block\">\n                        <div class=\"flex items-baseline justify-between gap-4\" data-kid=\"2-3-1-3-1-1-1\" data-name=\"step 1 header row\">\n                            <h2 class=\"flex items-center gap-3 font-display text-[20px] font-semibold text-[var(--ink)]\" data-kid=\"2-3-1-3-1-1-1-1\" data-name=\"step 1 heading with number\">\n                                <span class=\"w-6 h-6 rounded-full border border-[rgba(56,217,229,0.45)] text-[var(--accent)] text-[12px] font-medium grid place-items-center shrink-0\" data-kid=\"2-3-1-3-1-1-1-1-1\" data-name=\"step 1 number circle\">\n                                    1\n                                </span>\n                                Which issue are you seeing?\n                            </h2>\n                            <span class=\"text-[12.5px] text-[var(--muted)] shrink-0\" data-kid=\"2-3-1-3-1-1-1-2\" data-name=\"choose-one hint label\">\n                                Choose one\n                            </span>\n                        </div>\n                        <div class=\"mt-4 grid sm:grid-cols-2 gap-3\" data-kid=\"2-3-1-3-1-1-2\" data-name=\"issue type options grid\">\n                            <button class=\"tile-in relative text-left rounded-2xl bg-[rgba(56,217,229,0.08)] border border-[rgba(56,217,229,0.45)] p-4 flex gap-3.5 items-start hover:border-[var(--accent)]\" data-kid=\"2-3-1-3-1-1-2-1\" data-name=\"selected issue-type tile swap failed\">\n                                <span class=\"shrink-0 w-9 h-9 rounded-xl bg-[rgba(56,217,229,0.16)] text-[var(--accent)] grid place-items-center\" data-kid=\"2-3-1-3-1-1-2-1-1\" data-name=\"issue tile icon container\">\n                                    <svg class=\"w-[18px] h-[18px]\" data-kid=\"2-3-1-3-1-1-2-1-1-1\" data-name=\"swap arrows icon\" viewbox=\"0 0 24 24\">\n                                        <use href=\"#ic-swap\">\n                                        </use>\n                                    </svg>\n                                </span>\n                                <span class=\"min-w-0 pr-5\" data-kid=\"2-3-1-3-1-1-2-1-2\" data-name=\"issue tile text block\">\n                                    <span class=\"block text-[14.5px] font-medium text-[var(--ink)]\" data-kid=\"2-3-1-3-1-1-2-1-2-1\" data-name=\"issue tile title\">\n                                        Transaction or swap failed\n                                    </span>\n                                    <span class=\"block text-[13px] mt-0.5\" data-kid=\"2-3-1-3-1-1-2-1-2-2\" data-name=\"issue tile description\">\n                                        Reverted, dropped, or stuck before confirming.\n                                    </span>\n                                </span>\n                                <span class=\"absolute top-3.5 right-3.5 text-[var(--accent)]\" data-kid=\"2-3-1-3-1-1-2-1-3\" data-name=\"selected-state checkmark container\">\n                                    <svg class=\"w-[15px] h-[15px]\" data-kid=\"2-3-1-3-1-1-2-1-3-1\" data-name=\"checkmark icon\" viewbox=\"0 0 24 24\">\n                                        <use href=\"#ic-check\">\n                                        </use>\n                                    </svg>\n                                </span>\n                            </button>\n                            <button class=\"tile-in relative text-left rounded-2xl bg-[var(--well)] border border-[var(--line)] p-4 flex gap-3.5 items-start hover:border-[var(--line-strong)]\" data-kid=\"2-3-1-3-1-1-2-2\" data-name=\"issue-type tile RPC error\">\n                                <span class=\"shrink-0 w-9 h-9 rounded-xl bg-[var(--surface-2)] text-[var(--body)] grid place-items-center\" data-kid=\"2-3-1-3-1-1-2-2-1\" data-name=\"issue tile icon container\">\n                                    <svg class=\"w-[18px] h-[18px]\" data-kid=\"2-3-1-3-1-1-2-2-1-1\" data-name=\"plug icon\" viewbox=\"0 0 24 24\">\n                                        <use href=\"#ic-plug\">\n                                        </use>\n                                    </svg>\n                                </span>\n                                <span class=\"min-w-0\" data-kid=\"2-3-1-3-1-1-2-2-2\" data-name=\"issue tile text block\">\n                                    <span class=\"block text-[14.5px] font-medium text-[var(--ink)]\" data-kid=\"2-3-1-3-1-1-2-2-2-1\" data-name=\"issue tile title\">\n                                        RPC or connection error\n                                    </span>\n                                    <span class=\"block text-[13px] mt-0.5\" data-kid=\"2-3-1-3-1-1-2-2-2-2\" data-name=\"issue tile description\">\n                                        App won't load, or balances won't refresh.\n                                    </span>\n                                </span>\n                            </button>\n                            <button class=\"tile-in relative text-left rounded-2xl bg-[var(--well)] border border-[var(--line)] p-4 flex gap-3.5 items-start hover:border-[var(--line-strong)]\" data-kid=\"2-3-1-3-1-1-2-3\" data-name=\"issue-type tile cross-chain delay\">\n                                <span class=\"shrink-0 w-9 h-9 rounded-xl bg-[var(--surface-2)] text-[var(--body)] grid place-items-center\" data-kid=\"2-3-1-3-1-1-2-3-1\" data-name=\"issue tile icon container\">\n                                    <svg class=\"w-[18px] h-[18px]\" data-kid=\"2-3-1-3-1-1-2-3-1-1\" data-name=\"hourglass icon\" viewbox=\"0 0 24 24\">\n                                        <use href=\"#ic-hourglass\">\n                                        </use>\n                                    </svg>\n                                </span>\n                                <span class=\"min-w-0\" data-kid=\"2-3-1-3-1-1-2-3-2\" data-name=\"issue tile text block\">\n                                    <span class=\"block text-[14.5px] font-medium text-[var(--ink)]\" data-kid=\"2-3-1-3-1-1-2-3-2-1\" data-name=\"issue tile title\">\n                                        Cross-chain transfer delayed\n                                    </span>\n                                    <span class=\"block text-[13px] mt-0.5\" data-kid=\"2-3-1-3-1-1-2-3-2-2\" data-name=\"issue tile description\">\n                                        Sent on one network, not arrived on the other.\n                                    </span>\n                                </span>\n                            </button>\n                            <button class=\"tile-in relative text-left rounded-2xl bg-[var(--well)] border border-[var(--line)] p-4 flex gap-3.5 items-start hover:border-[var(--line-strong)]\" data-kid=\"2-3-1-3-1-1-2-4\" data-name=\"issue-type tile slippage\">\n                                <span class=\"shrink-0 w-9 h-9 rounded-xl bg-[var(--surface-2)] text-[var(--body)] grid place-items-center\" data-kid=\"2-3-1-3-1-1-2-4-1\" data-name=\"issue tile icon container\">\n                                    <svg class=\"w-[18px] h-[18px]\" data-kid=\"2-3-1-3-1-1-2-4-1-1\" data-name=\"percent icon\" viewbox=\"0 0 24 24\">\n                                        <use href=\"#ic-percent\">\n                                        </use>\n                                    </svg>\n                                </span>\n                                <span class=\"min-w-0\" data-kid=\"2-3-1-3-1-1-2-4-2\" data-name=\"issue tile text block\">\n                                    <span class=\"block text-[14.5px] font-medium text-[var(--ink)]\" data-kid=\"2-3-1-3-1-1-2-4-2-1\" data-name=\"issue tile title\">\n                                        Slippage or price mismatch\n                                    </span>\n                                    <span class=\"block text-[13px] mt-0.5\" data-kid=\"2-3-1-3-1-1-2-4-2-2\" data-name=\"issue tile description\">\n                                        Quoted amount differs from what you received.\n                                    </span>\n                                </span>\n                            </button>\n                            <button class=\"tile-in relative text-left rounded-2xl bg-[var(--well)] border border-[var(--line)] p-4 flex gap-3.5 items-start hover:border-[var(--line-strong)]\" data-kid=\"2-3-1-3-1-1-2-5\" data-name=\"issue-type tile balance not showing\">\n                                <span class=\"shrink-0 w-9 h-9 rounded-xl bg-[var(--surface-2)] text-[var(--body)] grid place-items-center\" data-kid=\"2-3-1-3-1-1-2-5-1\" data-name=\"issue tile icon container\">\n                                    <svg class=\"w-[18px] h-[18px]\" data-kid=\"2-3-1-3-1-1-2-5-1-1\" data-name=\"coins icon\" viewbox=\"0 0 24 24\">\n                                        <use href=\"#ic-coins\">\n                                        </use>\n                                    </svg>\n                                </span>\n                                <span class=\"min-w-0\" data-kid=\"2-3-1-3-1-1-2-5-2\" data-name=\"issue tile text block\">\n                                    <span class=\"block text-[14.5px] font-medium text-[var(--ink)]\" data-kid=\"2-3-1-3-1-1-2-5-2-1\" data-name=\"issue tile title\">\n                                        Balance or token not showing\n                                    </span>\n                                    <span class=\"block text-[13px] mt-0.5\" data-kid=\"2-3-1-3-1-1-2-5-2-2\" data-name=\"issue tile description\">\n                                        A holding is missing or reads incorrectly.\n                                    </span>\n                                </span>\n                            </button>\n                            <button class=\"tile-in relative text-left rounded-2xl bg-[var(--well)] border border-[var(--line)] p-4 flex gap-3.5 items-start hover:border-[var(--line-strong)]\" data-kid=\"2-3-1-3-1-1-2-6\" data-name=\"issue-type tile something else\">\n                                <span class=\"shrink-0 w-9 h-9 rounded-xl bg-[var(--surface-2)] text-[var(--body)] grid place-items-center\" data-kid=\"2-3-1-3-1-1-2-6-1\" data-name=\"issue tile icon container\">\n                                    <svg class=\"w-[18px] h-[18px]\" data-kid=\"2-3-1-3-1-1-2-6-1-1\" data-name=\"ellipsis dots icon\" viewbox=\"0 0 24 24\">\n                                        <use href=\"#ic-dots\">\n                                        </use>\n                                    </svg>\n                                </span>\n                                <span class=\"min-w-0\" data-kid=\"2-3-1-3-1-1-2-6-2\" data-name=\"issue tile text block\">\n                                    <span class=\"block text-[14.5px] font-medium text-[var(--ink)]\" data-kid=\"2-3-1-3-1-1-2-6-2-1\" data-name=\"issue tile title\">\n                                        Something else\n                                    </span>\n                                    <span class=\"block text-[13px] mt-0.5\" data-kid=\"2-3-1-3-1-1-2-6-2-2\" data-name=\"issue tile description\">\n                                        Describe it in the details step below.\n                                    </span>\n                                </span>\n                            </button>\n                        </div>\n                    </div>\n                    <div data-kid=\"2-3-1-3-1-2\" data-name=\"step 2 details block\">\n                        <div class=\"flex items-baseline justify-between gap-4\" data-kid=\"2-3-1-3-1-2-1\" data-name=\"step 2 header row\">\n                            <h2 class=\"flex items-center gap-3 font-display text-[20px] font-semibold text-[var(--ink)]\" data-kid=\"2-3-1-3-1-2-1-1\" data-name=\"step 2 heading with number\">\n                                <span class=\"w-6 h-6 rounded-full border border-[rgba(56,217,229,0.45)] text-[var(--accent)] text-[12px] font-medium grid place-items-center shrink-0\" data-kid=\"2-3-1-3-1-2-1-1-1\" data-name=\"step 2 number circle\">\n                                    2\n                                </span>\n                                Add the details\n                            </h2>\n                            <span class=\"text-[12.5px] text-[var(--muted)] shrink-0\" data-kid=\"2-3-1-3-1-2-1-2\" data-name=\"optional-fields hint label\">\n                                Optional fields can be skipped\n                            </span>\n                        </div>\n                        <div class=\"mt-4 grid sm:grid-cols-2 gap-4\" data-kid=\"2-3-1-3-1-2-2\" data-name=\"details fields grid\">\n                            <div data-kid=\"2-3-1-3-1-2-2-1\" data-name=\"network field wrapper\">\n                                <label class=\"block text-[13px] font-medium text-[var(--ink)] mb-2\" data-kid=\"2-3-1-3-1-2-2-1-1\" data-name=\"network field label\" for=\"network\">\n                                    Network\n                                </label>\n                                <div class=\"relative\" data-kid=\"2-3-1-3-1-2-2-1-2\" data-name=\"network select container\">\n                                    <select class=\"w-full appearance-none well rounded-xl px-4 py-3 text-[14px] text-[var(--ink)] outline-none focus:border-[var(--accent)]\" data-kid=\"2-3-1-3-1-2-2-1-2-1\" data-name=\"network dropdown select\" id=\"network\">\n                                        <option data-kid=\"2-3-1-3-1-2-2-1-2-1-1\" data-name=\"network option Base\">\n                                            Base\n                                        </option>\n                                        <option data-kid=\"2-3-1-3-1-2-2-1-2-1-2\" data-name=\"network option Ethereum\">\n                                            Ethereum\n                                        </option>\n                                        <option data-kid=\"2-3-1-3-1-2-2-1-2-1-3\" data-name=\"network option Arbitrum\">\n                                            Arbitrum\n                                        </option>\n                                        <option data-kid=\"2-3-1-3-1-2-2-1-2-1-4\" data-name=\"network option Polygon\">\n                                            Polygon\n                                        </option>\n                                        <option data-kid=\"2-3-1-3-1-2-2-1-2-1-5\" data-name=\"network option Solana\">\n                                            Solana\n                                        </option>\n                                        <option data-kid=\"2-3-1-3-1-2-2-1-2-1-6\" data-name=\"network option Other\">\n                                            Other / not sure\n                                        </option>\n                                    </select>\n                                    <span class=\"pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 text-[var(--muted)]\" data-kid=\"2-3-1-3-1-2-2-1-2-2\" data-name=\"dropdown caret icon container\">\n                                        <svg class=\"w-[15px] h-[15px]\" data-kid=\"2-3-1-3-1-2-2-1-2-2-1\" data-name=\"down caret icon\" viewbox=\"0 0 24 24\">\n                                            <use href=\"#ic-caret\">\n                                            </use>\n                                        </svg>\n                                    </span>\n                                </div>\n                            </div>\n                            <div data-kid=\"2-3-1-3-1-2-2-2\" data-name=\"transaction hash field wrapper\">\n                                <label class=\"block text-[13px] font-medium text-[var(--ink)] mb-2\" data-kid=\"2-3-1-3-1-2-2-2-1\" data-name=\"tx hash field label with optional tag\" for=\"txhash\">\n                                    Transaction hash\n                                    <span class=\"text-[var(--muted)] font-normal\" data-kid=\"2-3-1-3-1-2-2-2-1-1\" data-name=\"optional tag annotation\">\n                                        — optional\n                                    </span>\n                                </label>\n                                <div class=\"relative\" data-kid=\"2-3-1-3-1-2-2-2-2\" data-name=\"tx hash input container\">\n                                    <span class=\"pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-[var(--muted)]\" data-kid=\"2-3-1-3-1-2-2-2-2-1\" data-name=\"hash prefix icon container\">\n                                        <svg class=\"w-[15px] h-[15px]\" data-kid=\"2-3-1-3-1-2-2-2-2-1-1\" data-name=\"hash symbol icon\" viewbox=\"0 0 24 24\">\n                                            <use href=\"#ic-hash\">\n                                            </use>\n                                        </svg>\n                                    </span>\n                                    <input class=\"w-full well rounded-xl pl-10 pr-4 py-3 text-[13px] text-[var(--ink)] outline-none focus:border-[var(--accent)] font-mono\" data-kid=\"2-3-1-3-1-2-2-2-2-2\" data-name=\"transaction hash text input\" id=\"txhash\" type=\"text\" value=\"0x7f3c9be41d20a5c8ef6b14d2c07a83b591d6f72c05ae\"/>\n                                </div>\n                                <p class=\"text-[12px] mt-1.5 text-[var(--muted)]\" data-kid=\"2-3-1-3-1-2-2-2-3\" data-name=\"tx hash help note\">\n                                    A public hash only. Never paste a seed phrase or private key.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"mt-4\" data-kid=\"2-3-1-3-1-2-3\" data-name=\"issue description field block\">\n                            <label class=\"block text-[13px] font-medium text-[var(--ink)] mb-2\" data-kid=\"2-3-1-3-1-2-3-1\" data-name=\"issue description label\" for=\"desc\">\n                                Issue description\n                            </label>\n                            <textarea class=\"w-full well rounded-xl px-4 py-3 text-[14px] leading-relaxed text-[var(--ink)] outline-none focus:border-[var(--accent)] resize-none\" data-kid=\"2-3-1-3-1-2-3-2\" data-name=\"issue description textarea\" id=\"desc\" rows=\"5\">The swap on Base kept failing with a \"transaction reverted\" warning. I retried twice around 14:20 UTC and both attempts stopped after the approval step. Gas settings were left on default.</textarea>\n                            <div class=\"flex items-center justify-between gap-4 mt-1.5\" data-kid=\"2-3-1-3-1-2-3-3\" data-name=\"textarea footer row\">\n                                <p class=\"text-[12px] text-[var(--muted)]\" data-kid=\"2-3-1-3-1-2-3-3-1\" data-name=\"description help hint\">\n                                    Steps to reproduce, the exact message, and when it started all help.\n                                </p>\n                                <span class=\"text-[12px] text-[var(--muted)] shrink-0\" data-dynamic=\"true\" data-kid=\"2-3-1-3-1-2-3-3-2\" data-name=\"character counter\" data-reason=\"character count recomputed by character-count script as textarea input changes\">\n                                    214 / 600\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <!-- step 3 review -->\n                <div class=\"lg:sticky lg:top-6\" data-kid=\"2-3-1-3-2\" data-name=\"sticky review panel column\">\n                    <div class=\"rounded-[22px] bg-[var(--surface-2)] border border-[var(--line-strong)] p-5\" data-kid=\"2-3-1-3-2-1\" data-name=\"email review card\">\n                        <div class=\"flex items-center justify-between gap-3\" data-kid=\"2-3-1-3-2-1-1\" data-name=\"review card header row\">\n                            <h2 class=\"flex items-center gap-3 font-display text-[18px] font-semibold text-[var(--ink)]\" data-kid=\"2-3-1-3-2-1-1-1\" data-name=\"review heading with number\">\n                                <span class=\"w-6 h-6 rounded-full border border-[rgba(56,217,229,0.45)] text-[var(--accent)] text-[12px] font-medium grid place-items-center shrink-0\" data-kid=\"2-3-1-3-2-1-1-1-1\" data-name=\"review step number circle\">\n                                    3\n                                </span>\n                                Review your email\n                            </h2>\n                            <span class=\"text-[11.5px] text-[var(--accent)] bg-[rgba(56,217,229,0.12)] rounded-full px-2.5 py-1 shrink-0\" data-kid=\"2-3-1-3-2-1-1-2\" data-name=\"draft-not-sent status badge\">\n                                Draft, not sent\n                            </span>\n                        </div>\n                        <p class=\"text-[13px] mt-3\" data-kid=\"2-3-1-3-2-1-2\" data-name=\"review addressed-to line\">\n                            Addressed to\n                            <span class=\"text-[var(--ink)]\" data-kid=\"2-3-1-3-2-1-2-1\" data-name=\"review destination email\">\n                                Willsmith199425@gmail.com\n                            </span>\n                            . Every answer is numbered, in this order.\n                        </p>\n                        <div class=\"mt-4 rounded-2xl bg-[var(--well)] border border-[var(--line)] divide-y divide-[var(--line)]\" data-kid=\"2-3-1-3-2-1-3\" data-name=\"email draft summary list\">\n                            <div class=\"p-4 flex gap-3\" data-kid=\"2-3-1-3-2-1-3-1\" data-name=\"draft item issue type\">\n                                <span class=\"text-[12.5px] text-[var(--accent)] font-semibold w-4 shrink-0 pt-0.5\" data-kid=\"2-3-1-3-2-1-3-1-1\" data-name=\"draft item number label\">\n                                    1.\n                                </span>\n                                <div class=\"min-w-0\" data-kid=\"2-3-1-3-2-1-3-1-2\" data-name=\"draft item text block\">\n                                    <span class=\"block text-[12px] text-[var(--muted)]\" data-kid=\"2-3-1-3-2-1-3-1-2-1\" data-name=\"draft item label\">\n                                        Issue type\n                                    </span>\n                                    <span class=\"block text-[13.5px] text-[var(--ink)] mt-0.5\" data-dynamic=\"true\" data-kid=\"2-3-1-3-2-1-3-1-2-2\" data-name=\"draft issue-type value\" data-reason=\"value text synced from selected issue-type tile by script\">\n                                        Transaction or swap failed\n                                    </span>\n                                </div>\n                            </div>\n                            <div class=\"p-4 flex gap-3\" data-kid=\"2-3-1-3-2-1-3-2\" data-name=\"draft item network\">\n                                <span class=\"text-[12.5px] text-[var(--accent)] font-semibold w-4 shrink-0 pt-0.5\" data-kid=\"2-3-1-3-2-1-3-2-1\" data-name=\"draft item number label\">\n                                    2.\n                                </span>\n                                <div class=\"min-w-0\" data-kid=\"2-3-1-3-2-1-3-2-2\" data-name=\"draft item text block\">\n                                    <span class=\"block text-[12px] text-