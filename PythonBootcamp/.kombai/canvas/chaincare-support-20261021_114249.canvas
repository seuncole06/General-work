n\">\n                                <span class=\"text-[12.5px] text-[var(--accent)] font-semibold w-4 shrink-0 pt-0.5\" data-kid=\"2-3-1-3-2-1-3-4-1\" data-name=\"draft item number label\">\n                                    4.\n                                </span>\n                                <div class=\"min-w-0\" data-kid=\"2-3-1-3-2-1-3-4-2\" data-name=\"draft item text block\">\n                                    <span class=\"block text-[12px] text-[var(--muted)]\" data-kid=\"2-3-1-3-2-1-3-4-2-1\" data-name=\"draft item label\">\n                                        Issue description\n                                    </span>\n                                    <span class=\"block text-[12.5px] text-[var(--ink)] mt-1 leading-relaxed\" data-dynamic=\"true\" data-kid=\"2-3-1-3-2-1-3-4-2-2\" data-name=\"draft description value\" data-reason=\"value text synced from description textarea by script\">\n                                        The swap on Base kept failing with a \"transaction reverted\" warning. I retried twice around 14:20 UTC and both attempts stopped after the approval step. Gas settings were left on default.\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                        <a class=\"mt-4 w-full rounded-full bg-[var(--accent)] text-[#04212a] font-medium text-[15px] py-3.5 px-5 flex items-center justify-center gap-2.5 hover:bg-[#5fe4ed]\" data-dynamic=\"true\" data-kid=\"2-3-1-3-2-1-4\" data-name=\"open email draft CTA button\" data-reason=\"mailto href rebuilt by script from form field values\" href=\"mailto:Willsmith199425@gmail.com?subject=ChainCare%20support%20request%20%E2%80%94%20Transaction%20or%20swap%20failed&body=1.%20Issue%20type%3A%20Transaction%20or%20swap%20failed%0A2.%20Network%3A%20Base%0A3.%20Transaction%20hash%3A%200x7f3c9be41d20a5c8ef6b14d2c07a83b591d6f72c05ae%0A4.%20Issue%20description%3A%20The%20swap%20on%20Base%20kept%20failing%20with%20a%20%22transaction%20reverted%22%20warning.%20I%20retried%20twice%20around%2014%3A20%20UTC%20and%20both%20attempts%20stopped%20after%20the%20approval%20step.%20Gas%20settings%20were%20left%20on%20default.\">\n                            <svg class=\"w-[17px] h-[17px]\" data-kid=\"2-3-1-3-2-1-4-1\" data-name=\"email envelope icon\" viewbox=\"0 0 24 24\">\n                                <use href=\"#ic-mail\">\n                                </use>\n                            </svg>\n                            Open prefilled email draft\n                        </a>\n                        <p class=\"text-[12.5px] leading-relaxed mt-3 text-center\" data-kid=\"2-3-1-3-2-1-5\" data-name=\"draft disclaimer note\">\n                            This opens your mail app with the message above already written. You read it, edit anything you like, then press send — ChainCare never sends on your behalf.\n                        </p>\n                        <div class=\"mt-4 pt-4 border-t border-[var(--line)] flex items-center justify-between gap-3\" data-kid=\"2-3-1-3-2-1-6\" data-name=\"copy-actions row\">\n                            <span class=\"text-[12.5px] text-[var(--muted)]\" data-kid=\"2-3-1-3-2-1-6-1\" data-name=\"copy action prompt text\">\n                                Need the text pasted elsewhere?\n                            </span>\n                            <button class=\"text-[12.5px] font-medium text-[var(--ink)] border border-[var(--line-strong)] rounded-full px-3.5 py-1.5 flex items-center gap-2 hover:border-[var(--accent)] hover:text-[var(--accent)]\" data-kid=\"2-3-1-3-2-1-6-2\" data-name=\"copy draft button\">\n                                <svg class=\"w-[14px] h-[14px]\" data-kid=\"2-3-1-3-2-1-6-2-1\" data-name=\"copy icon\" viewbox=\"0 0 24 24\">\n                                    <use href=\"#ic-copy\">\n                                    </use>\n                                </svg>\n                                Copy draft\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- help directory -->\n    <section class=\"reveal mx-auto max-w-[1240px] px-6 lg:px-10 pt-16 pb-20\" data-kid=\"2-4\" data-name=\"help guides directory section\">\n        <div class=\"flex flex-wrap items-end justify-between gap-6\" data-kid=\"2-4-1\" data-name=\"section header row\">\n            <div data-kid=\"2-4-1-1\" data-name=\"section intro block\">\n                <h2 class=\"font-display text-[28px] md:text-[34px] font-semibold text-[var(--ink)] leading-tight\" data-kid=\"2-4-1-1-1\" data-name=\"section headline\">\n                    Answers you can use right now.\n                </h2>\n                <p class=\"mt-2 text-[15px] max-w-[580px]\" data-kid=\"2-4-1-1-2\" data-name=\"section intro text\">\n                    Most requests we get are covered by one of these guides. If it fixes your problem, you may not need to write to us at all.\n                </p>\n            </div>\n            <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"2-4-1-2\" data-name=\"guides category filter bar\">\n                <button class=\"text-[13px] font-medium rounded-full px-4 py-2 bg-[var(--accent)] text-[#04212a]\" data-kid=\"2-4-1-2-1\" data-name=\"active filter all guides\">\n                    All guides\n                </button>\n                <button class=\"text-[13px] rounded-full px-4 py-2 border border-[var(--line)] text-[var(--body)] hover:border-[var(--line-strong)] hover:text-[var(--ink)]\" data-kid=\"2-4-1-2-2\" data-name=\"filter button transactions\">\n                    Transactions\n                </button>\n                <button class=\"text-[13px] rounded-full px-4 py-2 border border-[var(--line)] text-[var(--body)] hover:border-[var(--line-strong)] hover:text-[var(--ink)]\" data-kid=\"2-4-1-2-3\" data-name=\"filter button connectivity\">\n                    Connectivity\n                </button>\n                <button class=\"text-[13px] rounded-full px-4 py-2 border border-[var(--line)] text-[var(--body)] hover:border-[var(--line-strong)] hover:text-[var(--ink)]\" data-kid=\"2-4-1-2-4\" data-name=\"filter button transfers\">\n                    Transfers\n                </button>\n                <button class=\"text-[13px] rounded-full px-4 py-2 border border-[var(--line)] text-[var(--body)] hover:border-[var(--line-strong)] hover:text-[var(--ink)]\" data-kid=\"2-4-1-2-5\" data-name=\"filter button tokens\">\n                    Tokens\n                </button>\n            </div>\n        </div>\n        <div class=\"mt-9 grid md:grid-cols-3 gap-x-12 gap-y-10\" data-kid=\"2-4-2\" data-name=\"guide categories grid\">\n            <div data-kid=\"2-4-2-1\" data-name=\"Transactions guides column\">\n                <div class=\"flex items-baseline justify-between gap-3 pb-3 border-b border-[var(--line-strong)]\" data-kid=\"2-4-2-1-1\" data-name=\"category header row\">\n                    <h3 class=\"font-display text-[15px] font-semibold text-[var(--ink)]\" data-kid=\"2-4-2-1-1-1\" data-name=\"category heading transactions\">\n                        Transactions\n                    </h3>\n                    <span class=\"text-[12.5px] text-[var(--muted)]\" data-kid=\"2-4-2-1-1-2\" data-name=\"category guide count\">\n                        3 guides\n                    </span>\n                </div>\n                <ul class=\"divide-y divide-[var(--line)]\" data-kid=\"2-4-2-1-2\" data-name=\"category guides list\">\n                    <li data-kid=\"2-4-2-1-2-1\" data-name=\"guide list item 1\">\n                        <a class=\"tile-in group flex items-start gap-3 py-3.5\" data-kid=\"2-4-2-1-2-1-1\" data-name=\"guide link pending swap\" href=\"#guides\">\n                            <span class=\"min-w-0\" data-kid=\"2-4-2-1-2-1-1-1\" data-name=\"guide text block\">\n                                <span class=\"block text-[14.5px] text-[var(--ink)] font-medium leading-snug group-hover:text-[var(--accent)]\" data-kid=\"2-4-2-1-2-1-1-1-1\" data-name=\"guide title\">\n                                    Why a swap still shows as pending\n                                </span>\n                                <span class=\"block text-[13px] mt-1\" data-kid=\"2-4-2-1-2-1-1-1-2\" data-name=\"guide summary\">\n                                    Check the public hash before assuming funds are lost. 3 min read\n                                </span>\n                            </span>\n                            <span class=\"shrink-0 mt-1 text-[var(--muted)] group-hover:text-[var(--accent)]\" data-kid=\"2-4-2-1-2-1-1-2\" data-name=\"guide arrow icon container\">\n                                <svg class=\"w-[15px] h-[15px]\" data-kid=\"2-4-2-1-2-1-1-2-1\" data-name=\"right arrow icon\" viewbox=\"0 0 24 24\">\n                                    <use href=\"#ic-arrow\">\n                                    </use>\n                                </svg>\n                            </span>\n                        </a>\n                    </li>\n                    <li data-kid=\"2-4-2-1-2-2\" data-name=\"guide list item 2\">\n                        <a class=\"tile-in group flex items-start gap-3 py-3.5\" data-kid=\"2-4-2-1-2-2-1\" data-name=\"guide link reading slippage\" href=\"#guides\">\n                            <span class=\"min-w-0\" data-kid=\"2-4-2-1-2-2-1-1\" data-name=\"guide text block\">\n                                <span class=\"block text-[14.5px] text-[var(--ink)] font-medium leading-snug group-hover:text-[var(--accent)]\" data-kid=\"2-4-2-1-2-2-1-1-1\" data-name=\"guide title\">\n                                    Reading slippage before you approve\n                                </span>\n                                <span class=\"block text-[13px] mt-1\" data-kid=\"2-4-2-1-2-2-1-1-2\" data-name=\"guide summary\">\n                                    Why a tight tolerance makes swaps revert. 3 min read\n                                </span>\n                            </span>\n                            <span class=\"shrink-0 mt-1 text-[var(--muted)] group-hover:text-[var(--accent)]\" data-kid=\"2-4-2-1-2-2-1-2\" data-name=\"guide arrow icon container\">\n                                <svg class=\"w-[15px] h-[15px]\" data-kid=\"2-4-2-1-2-2-1-2-1\" data-name=\"right arrow icon\" viewbox=\"0 0 24 24\">\n                                    <use href=\"#ic-arrow\">\n                                    </use>\n                                </svg>\n                            </span>\n                        </a>\n                    </li>\n                    <li data-kid=\"2-4-2-1-2-3\" data-name=\"guide list item 3\">\n                        <a class=\"tile-in group flex items-start gap-3 py-3.5\" data-kid=\"2-4-2-1-2-3-1\" data-name=\"guide link finding tx hash\" href=\"#guides\">\n                            <span class=\"min-w-0\" data-kid=\"2-4-2-1-2-3-1-1\" data-name=\"guide text block\">\n                                <span class=\"block text-[14.5px] text-[var(--ink)] font-medium leading-snug group-hover:text-[var(--accent)]\" data-kid=\"2-4-2-1-2-3-1-1-1\" data-name=\"guide title\">\n                                    Where to find a transaction hash\n                                </span>\n                                <span class=\"block text-[13px] mt-1\" data-kid=\"2-4-2-1-2-3-1-1-2\" data-name=\"guide summary\">\n                                    You can optionally include the public hash in your details. 1 min read\n                                </span>\n                            </span>\n                            <span class=\"shrink-0 mt-1 text-[var(--muted)] group-hover:text-[var(--accent)]\" data-kid=\"2-4-2-1-2-3-1-2\" data-name=\"guide arrow icon container\">\n                                <svg class=\"w-[15px] h-[15px]\" data-kid=\"2-4-2-1-2-3-1-2-1\" data-name=\"right arrow icon\" viewbox=\"0 0 24 24\">\n                                    <use href=\"#ic-arrow\">\n                                    </use>\n                                </svg>\n                            </span>\n                        </a>\n                    </li>\n                </ul>\n            </div>\n            <div data-kid=\"2-4-2-2\" data-name=\"Connectivity guides column\">\n                <div class=\"flex items-baseline justify-between gap-3 pb-3 border-b border-[var(--line-strong)]\" data-kid=\"2-4-2-2-1\" data-name=\"category header row\">\n                    <h3 class=\"font-display text-[15px] font-semibold text-[var(--ink)]\" data-kid=\"2-4-2-2-1-1\" data-name=\"category heading connectivity\">\n                        Connectivity\n                    </h3>\n                    <span class=\"text-[12.5px] text-[var(--muted)]\" data-kid=\"2-4-2-2-1-2\" data-name=\"category guide count\">\n                        3 guides\n                    </span>\n                </div>\n                <ul class=\"divide-y divide-[var(--line)]\" data-kid=\"2-4-2-2-2\" data-name=\"category guides list\">\n                    <li data-kid=\"2-4-2-2-2-1\" data-name=\"guide list item 1\">\n                        <a class=\"tile-in group flex items-start gap-3 py-3.5\" data-kid=\"2-4-2-2-2-1-1\" data-name=\"guide link reset RPC\" href=\"#guides\">\n                            <span class=\"min-w-0\" data-kid=\"2-4-2-2-2-1-1-1\" data-name=\"guide text block\">\n                                <span class=\"block text-[14.5px] text-[var(--ink)] font-medium leading-snug group-hover:text-[var(--accent)]\" data-kid=\"2-4-2-2-2-1-1-1-1\" data-name=\"guide title\">\n                                    Reset an RPC connection in a few steps\n                                </span>\n                                <span class=\"block text-[13px] mt-1\" data-kid=\"2-4-2-2-2-1-1-1-2\" data-name=\"guide summary\">\n                                    Switch endpoints when balances stop refreshing. 2 min read\n                                </span>\n                            </span>\n                            <span class=\"shrink-0 mt-1 text-[var(--muted)] group-hover:text-[var(--accent)]\" data-kid=\"2-4-2-2-2-1-1-2\" data-name=\"guide arrow icon container\">\n                                <svg class=\"w-[15px] h-[15px]\" data-kid=\"2-4-2-2-2-1-1-2-1\" data-name=\"right arrow icon\" viewbox=\"0 0 24 24\">\n                                    <use href=\"#ic-arrow\">\n                                    </use>\n                                </svg>\n                            </span>\n                        </a>\n                    </li>\n                    <li data-kid=\"2-4-2-2-2-2\" data-name=\"guide list item 2\">\n                        <a class=\"tile-in group flex items-start gap-3 py-3.5\" data-kid=\"2-4-2-2-2-2-1\" data-name=\"guide link app hangs on load\" href=\"#guides\">\n                            <span class=\"min-w-0\" data-kid=\"2-4-2-2-2-2-1-1\" data-name=\"guide text block\">\n                                <span class=\"block text-[14.5px] text-[var(--ink)] font-medium leading-snug group-hover:text-[var(--accent)]\" data-kid=\"2-4-2-2-2-2-1-1-1\" data-name=\"guide title\">\n                                    The app hangs on load\n                                </span>\n                                <span class=\"block text-[13px] mt-1\" data-kid=\"2-4-2-2-2-2-1-1-2\" data-name=\"guide arrow icon container\">\n                                    Clearing site data and reloading usually clears it. 2 min read\n                                </span>\n                            </span>\n                            <span class=\"shrink-0 mt-1 text-[var(--muted)] group-hover:text-[var(--accent)]\" data-kid=\"2-4-2-2-2-2-1-2\">\n                                <svg class=\"w-[15px] h-[15px]\" data-kid=\"2-4-2-2-2-2-1-2-1\" viewbox=\"0 0 24 24\">\n                                    <use href=\"#ic-arrow\">\n                                    </use>\n                                </svg>\n                            </span>\n                        </a>\n                    </li>\n                    <li data-kid=\"2-4-2-2-2-3\" data-name=\"guide list item 3\">\n                        <a class=\"tile-in group flex items-start gap-3 py-3.5\" data-kid=\"2-4-2-2-2-3-1\" data-name=\"guide link wrong network\" href=\"#guides\">\n                            <span class=\"min-w-0\" data-kid=\"2-4-2-2-2-3-1-1\" data-name=\"guide text block\">\n                                <span class=\"block text-[14.5px] text-[var(--ink)] font-medium leading-snug group-hover:text-[var(--accent)]\" data-kid=\"2-4-2-2-2-3-1-1-1\" data-name=\"guide title\">\n                                    Your app is showing the wrong network\n                                </span>\n                                <span class=\"block text-[13px] mt-1\" data-kid=\"2-4-2-2-2-3-1-1-2\" data-name=\"guide arrow icon container\">\n                                    How the network picker reads your settings. 2 min read\n                                </span>\n                            </span>\n                            <span class=\"shrink-0 mt-1 text-[var(--muted)] group-hover:text-[var(--accent)]\" data-kid=\"2-4-2-2-2-3-1-2\">\n                                <svg class=\"w-[15px] h-[15px]\" data-kid=\"2-4-2-2-2-3-1-2-1\" viewbox=\"0 0 24 24\">\n                                    <use href=\"#ic-arrow\">\n                                    </use>\n                                </svg>\n                            </span>\n                        </a>\n                    </li>\n                </ul>\n            </div>\n            <div data-kid=\"2-4-2-3\" data-name=\"Transfers & balances guides column\">\n                <div class=\"flex items-baseline justify-between gap-3 pb-3 border-b border-[var(--line-strong)]\" data-kid=\"2-4-2-3-1\" data-name=\"category header row\">\n                    <h3 class=\"font-display text-[15px] font-semibold text-[var(--ink)]\" data-kid=\"2-4-2-3-1-1\" data-name=\"category heading transfers & balances\">\n                        Transfers & balances\n                    </h3>\n                    <span class=\"text-[12.5px] text-[var(--muted)]\" data-kid=\"2-4-2-3-1-2\" data-name=\"category guide count\">\n                        3 guides\n                    </span>\n                </div>\n                <ul class=\"divide-y divide-[var(--line)]\" data-kid=\"2-4-2-3-2\" data-name=\"category guides list\">\n                    <li data-kid=\"2-4-2-3-2-1\" data-name=\"guide list item 1\">\n                        <a class=\"tile-in group flex items-start gap-3 py-3.5\" data-kid=\"2-4-2-3-2-1-1\" data-name=\"guide link slow transfers\" href=\"#guides\">\n                            <span class=\"min-w-0\" data-kid=\"2-4-2-3-2-1-1-1\" data-name=\"guide text block\">\n                                <span class=\"block text-[14.5px] text-[var(--ink)] font-medium leading-snug group-hover:text-[var(--accent)]\" data-kid=\"2-4-2-3-2-1-1-1-1\" data-name=\"guide title\">\n                                    Transfers that take longer than expected\n                                </span>\n                                <span class=\"block text-[13px] mt-1\" data-kid=\"2-4-2-3-2-1-1-1-2\" data-name=\"guide arrow icon container\">\n                                    Cross-chain routes wait on both networks. 4 min read\n                                </span>\n                            </span>\n                            <span class=\"shrink-0 mt-1 text-[var(--muted)] group-hover:text-[var(--accent)]\" data-kid=\"2-4-2-3-2-1-1-2\">\n                                <svg class=\"w-[15px] h-[15px]\" data-kid=\"2-4-2-3-2-1-1-2-1\" viewbox=\"0 0 24 24\">\n                                    <use href=\"#ic-arrow\">\n                                    </use>\n                                </svg>\n                            </span>\n                        </a>\n                    </li>\n                    <li data-kid=\"2-4-2-3-2-2\" data-name=\"guide list item 2\">\n                        <a class=\"tile-in group flex items-start gap-3 py-3.5\" data-kid=\"2-4-2-3-2-2-1\" data-name=\"guide link stale balances\" href=\"#guides\">\n                            <span class=\"min-w-0\" data-kid=\"2-4-2-3-2-2-1-1\" data-name=\"guide text block\">\n                                <span class=\"block text-[14.5px] text-[var(--ink)] font-medium leading-snug group-hover:text-[var(--accent)]\" data-kid=\"2-4-2-3-2-2-1-1-1\" data-name=\"guide title\">\n                                    Balances that haven't refreshed yet\n                                </span>\n                                <span class=\"block text-[13px] mt-1\" data-kid=\"2-4-2-3-2-2-1-1-2\" data-name=\"guide summary\">\n                                    Token lists are cached on your device. 2 min read\n                                </span>\n                            </span>\n                            <span class=\"shrink-0 mt-1 text-[var(--muted)] group-hover:text-[var(--accent)]\" data-kid=\"2-4-2-3-2-2-1-2\">\n                                <svg class=\"w-[15px] h-[15px]\" data-kid=\"2-4-2-3-2-2-1-2-1\" viewbox=\"0 0 24 24\">\n                                    <use href=\"#ic-arrow\">\n                                    </use>\n                                </svg>\n                            </span>\n                        </a>\n                    </li>\n                    <li data-kid=\"2-4-2-3-2-3\" data-name=\"guide list item 3\">\n                        <a class=\"tile-in group flex items-start gap-3 py-3.5\" data-kid=\"2-4-2-3-2-3-1\" data-name=\"guide link missing token\" href=\"#guides\">\n                            <span class=\"min-w-0\" data-kid=\"2-4-2-3-2-3-1-1\" data-name=\"guide text block\">\n                                <span class=\"block text-[14.5px] text-[var(--ink)] font-medium leading-snug group-hover:text-[var(--accent)]\" data-kid=\"2-4-2-3-2-3-1-1-1\" data-name=\"guide title\">\n                                    A token isn't showing in your list\n                                </span>\n                                <span class=\"block text-[13px] mt-1\" data-kid=\"2-4-2-3-2-3-1-1-2\" data-name=\"guide summary\">\n                                    Re-adding the token contract by hand. 3 min read\n                                </span>\n                            </span>\n                            <span class=\"shrink-0 mt-1 text-[var(--muted)] group-hover:text-[var(--accent)]\" data-kid=\"2-4-2-3-2-3-1-2\">\n                                <svg class=\"w-[15px] h-[15px]\" data-kid=\"2-4-2-3-2-3-1-2-1\" viewbox=\"0 0 24 24\">\n                                    <use href=\"#ic-arrow\">\n                                    </use>\n                                </svg>\n                            </span>\n                        </a>\n                    </li>\n                </ul>\n            </div>\n        </div>\n    </section>\n    <!-- footer -->\n    <footer class=\"border-t border-[var(--line)]\" data-kid=\"2-5\" data-name=\"site footer\">\n        <div class=\"mx-auto max-w-[1240px] px-6 lg:px-10 py-8 flex flex-wrap items-center justify-between gap-5\" data-kid=\"2-5-1\" data-name=\"footer content row\">\n            <div class=\"flex items-center gap-3\" data-kid=\"2-5-1-1\" data-name=\"footer brand group\">\n                <span class=\"w-8 h-8 rounded-lg bg-[var(--surface-2)] border border-[var(--line-strong)] grid place-items-center text-[var(--accent)]\" data-kid=\"2-5-1-1-1\" data-name=\"footer brand logo badge\">\n                    <svg class=\"w-[16px] h-[16px]\" data-kid=\"2-5-1-1-1-1\" data-name=\"link chain logo icon\" viewbox=\"0 0 24 24\">\n                        <use href=\"#ic-link\">\n                        </use>\n                    </svg>\n                </span>\n                <span class=\"font-display text-[15px] font-medium text-[var(--ink)]\" data-kid=\"2-5-1-1-2\" data-name=\"footer brand name\">\n                    Asset RPC Support\n                </span>\n            </div>\n            <p class=\"text-[12.5px] text-[var(--muted)] flex items-center gap-2\" data-kid=\"2-5-1-2\" data-name=\"footer privacy statement\">\n                <svg class=\"w-[15px] h-[15px]\" data-kid=\"2-5-1-2-1\" data-name=\"lock icon\" viewbox=\"0 0 24 24\">\n                    <use href=\"#ic-lock\">\n                    </use>\n                </svg>\n                Email only. No wallet connection, no transfers, no seed phrase — ever.\n            </p>\n            <span class=\"text-[12.5px] text-[var(--muted)]\" data-kid=\"2-5-1-3\" data-name=\"copyright notice text\">\n                © 2026 ChainCare\n            </span>\n        </div>\n    </footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n\n  gsap.from(\".hero-item\", {\n    autoAlpha: 0,\n    y: 22,\n    duration: 0.7,\n    stagger: 0.09,\n    ease: \"power3.out\"\n  });\n\n  gsap.utils.toArray(\".reveal\").forEach(function (section) {\n    gsap.from(section, {\n      autoAlpha: 0,\n      y: 26,\n      duration: 0.65,\n      ease: \"power3.out\",\n      scrollTrigger: { trigger: section, start: \"top 88%\" }\n    });\n  });\n\n  gsap.utils.toArray(\".tile-in\").forEach(function (tile, i) {\n    gsap.from(tile, {\n      autoAlpha: 0,\n      y: 16,\n      duration: 0.5,\n      delay: (i % 6) * 0.04,\n      ease: \"power2.out\",\n      scrollTrigger: { trigger: tile, start: \"top 96%\" }\n    });\n  });\n</script>\n",
